<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy App.xaml
  Merge the Clipsy theme dictionaries here so styles apply globally to
  every Window in the app. Keep XamlControlsResources FIRST so our
  overrides win for SystemAccentColor, TextFill*, etc.
-->
<Application
    x:Class="Clipsy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///Themes/Clipsy.Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Clipsy.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
