<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · Settings window
  Discord-style sidebar nav + Blender-dense content cards.
  Keeps the same x:Names from the previous TabView so existing
  code-behind bindings (LangBox, BitrateSlider, RememberFolderSwitch,
  HotkeyList, etc.) keep working. The only new wiring needed is
  NavList_SelectionChanged — see SettingsWindow.xaml.cs.
-->
<Window
    x:Class="Clipsy.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{StaticResource ClipsyBg0Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============== Sidebar ============== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{StaticResource ClipsyBg0Brush}"
                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section label -->
                <TextBlock Grid.Row="0"
                           Text="SETTINGS"
                           Style="{StaticResource ClipsyLabel}"
                           Margin="18,18,18,10" />

                <!-- Nav list -->
                <ListView x:Name="NavList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="OnNavSelectionChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8,0,8,0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListViewItem x:Name="NavGeneral" Tag="general" IsSelected="True">
                        <Grid Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" />
                            <TextBlock x:Name="NavGeneralLabel" Grid.Column="1"
                                       Text="General" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="NavVideo" Tag="video">
                        <Grid Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE714;" FontSize="16" />
                            <TextBlock x:Name="NavVideoLabel" Grid.Column="1"
                                       Text="Video" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="NavGif" Tag="gif">
                        <Grid Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE91B;" FontSize="16" />
                            <TextBlock x:Name="NavGifLabel" Grid.Column="1"
                                       Text="GIF" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="NavHotkeys" Tag="hotkeys">
                        <Grid Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="16" />
                            <TextBlock x:Name="NavHotkeysLabel" Grid.Column="1"
                                       Text="Hotkeys" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="NavInfo" Tag="info">
                        <Grid Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" />
                            <TextBlock x:Name="NavInfoLabel" Grid.Column="1"
                                       Text="Info" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>
                </ListView>

                <!-- Tip card -->
                <Border Grid.Row="2"
                        Background="{StaticResource ClipsyBg1Brush}"
                        BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="12,12,12,16"
                        Padding="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="TIP" Style="{StaticResource ClipsyLabel}" />
                        <TextBlock x:Name="LblTip"
                                   Text="Press PrtSc anywhere to capture."
                                   Style="{StaticResource ClipsyHelper}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============== Content ============== -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource ClipsyBg1Brush}">
            <ScrollViewer Padding="32,28,32,20"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- All five panes are stacked at root; only the matching one is visible. -->

                    <!-- ===== General ===== -->
                    <StackPanel x:Name="PaneGeneral" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HdrGeneral" Text="General"
                                       Style="{StaticResource ClipsySectionTitle}" />
                            <TextBlock x:Name="SubGeneral"
                                       Text="Language, theme, and where files end up."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>

                        <!-- App + OCR -->
                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblLanguage" Text="Language"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperLanguage"
                                                   Text="Auto-detect uses the system locale."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LangBox" Width="240">
                                        <ComboBoxItem x:Name="LangAuto" Content="Auto-detect" Tag="auto" />
                                        <ComboBoxItem x:Name="LangEn" Content="English" Tag="en" />
                                        <ComboBoxItem x:Name="LangRu" Content="Russian" Tag="ru" />
                                    </ComboBox>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblTheme" Text="Theme"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperTheme"
                                                   Text="Live-switches without restart."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeBox" Width="240">
                                        <ComboBoxItem x:Name="ThemeAuto" Content="Auto-detect" Tag="auto" />
                                        <ComboBoxItem x:Name="ThemeDark" Content="Dark" Tag="dark" />
                                        <ComboBoxItem x:Name="ThemeLight" Content="Light" Tag="light" />
                                    </ComboBox>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblOcrEngine" Text="OCR engine"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperOcr"
                                                   Text="Tesseract is bundled. Windows OCR is faster but lower-quality."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ComboBox x:Name="OcrEngineBox" Width="240">
                                        <ComboBoxItem x:Name="OcrTesseract" Content="Tesseract (default)" Tag="Tesseract" />
                                        <ComboBoxItem x:Name="OcrWinRt" Content="Windows OCR" Tag="WinRT" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Folders + save -->
                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="LblScreenshotFolder" Text="Screenshot folder"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScreenshotFolderBox" Grid.Column="0" />
                                        <Button x:Name="ScreenshotFolderPick" Grid.Column="1"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Content="Browse"
                                                Click="OnScreenshotFolderPick" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="LblVideoFolder" Text="Video folder"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VideoFolderBox" Grid.Column="0" />
                                        <Button x:Name="VideoFolderPick" Grid.Column="1"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Content="Browse"
                                                Click="OnVideoFolderPick" />
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Remember last Save As folder"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperRemember"
                                                   Text="Future captures default to wherever you saved last."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RememberFolderSwitch" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="LblScreenshotFormat" Text="Screenshot format"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <ComboBox x:Name="ScreenshotFormatBox" Width="280" SelectionChanged="OnScreenshotFormatChanged">
                                        <ComboBoxItem x:Name="FmtPng" Content="PNG (lossless)" Tag="png" />
                                        <ComboBoxItem x:Name="FmtJpg" Content="JPEG (smaller)" Tag="jpg" />
                                        <ComboBoxItem x:Name="FmtWebp" Content="WebP (preview, falls back to PNG)" Tag="webp" />
                                    </ComboBox>
                                </StackPanel>

                                <Grid x:Name="JpgQualityRow" ColumnSpacing="10" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock x:Name="LblJpgQuality" Text="JPEG quality"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <Slider x:Name="JpgQualitySlider" StepFrequency="1"
                                                ValueChanged="OnJpgQualityChanged"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="JpgQualityLabel" Grid.Column="1"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4"
                                               Style="{StaticResource ClipsyMono}" />
                                </Grid>

                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="LblAfterSave" Text="After save"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <ComboBox x:Name="AfterSaveBox" Width="240">
                                        <ComboBoxItem x:Name="AfterNothing" Content="Do nothing" Tag="nothing" />
                                        <ComboBoxItem x:Name="AfterOpenFile" Content="Open file" Tag="open-file" />
                                        <ComboBoxItem x:Name="AfterOpenFolder" Content="Open folder" Tag="open-folder" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Updates -->
                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="LblUpdates" Text="Updates"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <TextBlock x:Name="HelperUpdates"
                                               Text="Last checked 2 hours ago."
                                               Style="{StaticResource ClipsyHelper}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="UpdateIntervalBox" Width="200">
                                        <ComboBoxItem x:Name="UpdHourly" Content="Hourly" Tag="hourly" />
                                        <ComboBoxItem x:Name="UpdDaily" Content="Daily" Tag="daily" />
                                        <ComboBoxItem x:Name="UpdWeekly" Content="Weekly" Tag="weekly" />
                                        <ComboBoxItem x:Name="UpdMonthly" Content="Monthly" Tag="monthly" />
                                        <ComboBoxItem x:Name="UpdNever" Content="Never" Tag="never" />
                                    </ComboBox>
                                    <Button x:Name="BtnCheckNow"
                                            Style="{StaticResource ClipsyButtonGhost}"
                                            Click="OnCheckUpdates">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="Check now" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Video ===== -->
                    <StackPanel x:Name="PaneVideo" Spacing="16" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HdrVideo" Text="Video"
                                       Style="{StaticResource ClipsySectionTitle}" />
                            <TextBlock x:Name="SubVideo"
                                       Text="Codec, resolution, and bitrate for screen recordings."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>

                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="LblCodec" Text="Codec"
                                               Style="{StaticResource ClipsyBodyStrong}" />
                                    <TextBlock x:Name="HelperCodec"
                                               Text="Default H.264 hardware encode at 30 fps."
                                               Style="{StaticResource ClipsyHelper}" />
                                </StackPanel>
                                <ComboBox x:Name="CodecBox" Width="320" SelectionChanged="OnCodecChanged">
                                    <ComboBoxItem x:Name="CodecH264Item" Content="H.264, wide compatibility" Tag="H.264" />
                                    <ComboBoxItem x:Name="CodecH265Item" Content="H.265, smaller files" Tag="H.265" />
                                    <ComboBoxItem x:Name="CodecVp9Item"  Content="VP9, web-friendly" Tag="VP9" />
                                    <ComboBoxItem x:Name="CodecAv1Item"  Content="AV1, smallest, slow encoder" Tag="AV1" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblResolution" Text="Resolution"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="LblRegionNote"
                                                   Text="Applies to full-screen recordings only. Region recordings use the selection size."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ResolutionBox" Width="240" SelectionChanged="OnResolutionChanged">
                                        <ComboBoxItem Content="480p" Tag="480p" />
                                        <ComboBoxItem Content="720p" Tag="720p" />
                                        <ComboBoxItem Content="1080p" Tag="1080p" />
                                        <ComboBoxItem Content="1440p" Tag="1440p" />
                                        <ComboBoxItem Content="Original" Tag="Original" />
                                    </ComboBox>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblBitrate" Text="Bitrate"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperBitrate"
                                                   Text="Higher bitrate = better quality and larger files. Max scales with resolution."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BitrateSlider" Grid.Column="0" StepFrequency="1"
                                                ValueChanged="OnBitrateChanged" />
                                        <TextBlock x:Name="BitrateLabel" Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource ClipsyMono}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Border Background="{StaticResource ClipsyBgInputBrush}"
                                        BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                                  Foreground="{StaticResource ClipsyText3Brush}" />
                                        <TextBlock x:Name="EstFileSizeLabel"
                                                   Style="{StaticResource ClipsyHelper}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== GIF ===== -->
                    <StackPanel x:Name="PaneGif" Spacing="16" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HdrGif" Text="GIF"
                                       Style="{StaticResource ClipsySectionTitle}" />
                            <TextBlock x:Name="SubGif"
                                       Text="Output settings when exporting recordings as animated GIF."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>

                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblGifColors" Text="Color count"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperGifColors"
                                                   Text="Fewer colors = smaller file but more banding."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GifColorSlider" Grid.Column="0" StepFrequency="16"
                                                ValueChanged="OnGifColorChanged" />
                                        <TextBlock x:Name="GifColorLabel" Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource ClipsyMono}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblGifFps" Text="Frame rate"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperGifFps"
                                                   Text="12 fps is a good default for screen content."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GifFpsSlider" Grid.Column="0" StepFrequency="1"
                                                ValueChanged="OnGifFpsChanged" />
                                        <TextBlock x:Name="GifFpsLabel" Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource ClipsyMono}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Dithering" Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperGifDither"
                                                   Text="Smooths color transitions at the cost of file size."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="GifDitherSwitch" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Hotkeys ===== -->
                    <StackPanel x:Name="PaneHotkeys" Spacing="16" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HdrHotkeys" Text="Hotkeys"
                                       Style="{StaticResource ClipsySectionTitle}" />
                            <TextBlock x:Name="LblHotkeyHint"
                                       Text="Click a binding, then press the key or combo. Esc cancels rebinding."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>

                        <Border Background="{StaticResource ClipsyBg2Brush}"
                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource ClipsyBg1Brush}"
                                        BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,8"
                                        CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ACTION" Style="{StaticResource ClipsyLabel}" />
                                        <TextBlock Grid.Column="1" Text="BINDING" Style="{StaticResource ClipsyLabel}"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- List body — DataTemplate handles rebinding state inline. -->
                                <ListView x:Name="HotkeyList"
                                          Grid.Row="1"
                                          SelectionMode="None"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="44" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="14,10"
                                                  Background="{Binding RowBackground}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Style="{StaticResource ClipsyBody}"
                                                           VerticalAlignment="Center" />
                                                <!--
                                                  One button. Its content swaps between the bound keys and a
                                                  "Press a key or combination..." prompt while the user is
                                                  rebinding. The code-behind toggles IsRebinding for the row
                                                  it's actively listening on.
                                                -->
                                                <Button Grid.Column="1"
                                                        Click="OnHotkeyRebindClick"
                                                        Tag="{Binding Key}"
                                                        HorizontalAlignment="Stretch"
                                                        Background="{Binding BindingBackground}"
                                                        BorderBrush="{Binding BindingBorderBrush}"
                                                        Foreground="{Binding BindingForeground}">
                                                    <Grid>
                                                        <!-- Idle state -->
                                                        <TextBlock Text="{Binding Binding}"
                                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                                   FontSize="11"
                                                                   Visibility="{Binding IdleVisibility}" />
                                                        <!-- Rebinding prompt -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    HorizontalAlignment="Center"
                                                                    Visibility="{Binding RebindingVisibility}">
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{StaticResource ClipsyAccentBrush}"
                                                                     VerticalAlignment="Center">
                                                                <Ellipse.Resources>
                                                                    <Storyboard x:Name="DotPulse" RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.3" Duration="0:0:0.6" />
                                                                    </Storyboard>
                                                                </Ellipse.Resources>
                                                            </Ellipse>
                                                            <TextBlock Text="Press a key or combination..."
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource ClipsyAccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== Info ===== -->
                    <StackPanel x:Name="PaneInfo" Spacing="16" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="14"
                                    Background="{StaticResource ClipsyAccentBrush}">
                                <FontIcon Glyph="&#xE722;" FontSize="28" Foreground="White" />
                            </Border>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Clipsy" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource ClipsyTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource ClipsyBgInputBrush}"
                                            BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="999" Padding="8,1">
                                        <TextBlock x:Name="VersionLabel"
                                                   Style="{StaticResource ClipsyMono}"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource ClipsyGroupCard}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Name="LblAuthor" Text="Author: Sidiusz"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock Text="MIT licensed"
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="github.com/Sidiusz/Clipsy"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock Text="Source, issues, releases"
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1"
                                                     Content="Open"
                                                     NavigateUri="https://github.com/Sidiusz/Clipsy"
                                                     VerticalAlignment="Center" />
                                </Grid>

                                <Border Style="{StaticResource ClipsyHairline}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Updates" Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="UpdateStatusLabel"
                                                   Text="You are on the latest version."
                                                   Foreground="{StaticResource ClipsySuccessBrush}"
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <Button x:Name="BtnCheckForUpdates" Grid.Column="1"
                                            Click="OnCheckUpdates" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="Check now" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ============== Footer ============== -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource ClipsyBg0Brush}"
                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ClipsyButtonGhost}"
                        Content="Reset" Click="OnReset" />
                <Button x:Name="BtnClose" Content="Close" Click="OnClose" />
                <Button x:Name="BtnSave" Style="{StaticResource ClipsyButtonPrimary}"
                        Content="Save changes" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
