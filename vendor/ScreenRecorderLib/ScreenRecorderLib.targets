<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="PlatformCheck" BeforeTargets="InjectReference"
          Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'">
    <Error Text="Clipsy's ScreenRecorderLib package requires Platform=x64 or Platform=ARM64." />
  </Target>
  <Target Name="InjectReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="ScreenRecorderLib">
        <HintPath>$(MSBuildThisFileDirectory)$(Platform)\ScreenRecorderLib.dll</HintPath>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
