<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · Capture overlay
  Same layout & x:Names as before; the styling delta is that toolbars,
  buttons, and panels all pull from Clipsy.Tokens / Clipsy.Styles via the
  shared resource dictionary. No hard-coded #F01E1E1E / #FF2E2E2E anymore.

  All existing event handlers (OnRecordClick, OnScreenshotClick, etc.)
  keep their names so code-behind continues to compile.
-->
<Window
    x:Class="Clipsy.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          IsTabStop="True"
          KeyDown="OnKeyDown"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased"
          PointerWheelChanged="OnRootPointerWheelChanged"
          RightTapped="OnRootRightTapped">

        <!-- Frozen desktop -->
        <Image x:Name="FrozenImage"
               Stretch="None"
               Opacity="1.0"
               IsHitTestVisible="False" />

        <!-- Even-odd dim cut-out for the selected region -->
        <!-- Opacity starts at 0: the window's first frame is composed BEFORE
             the intro animation runs, so a visible dim here flashed dark,
             snapped transparent, then faded back in. -->
        <Path x:Name="DimPath"
              Opacity="0"
              Fill="{ThemeResource ClipsyOverlayDimBrush}"
              IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup x:Name="DimGeometry" FillRule="EvenOdd" />
            </Path.Data>
        </Path>

        <!-- Drawings live in root DIPs (kept anchored on resize). -->
        <Canvas x:Name="DrawingCanvas"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- OCR overlay (yellow rects + clean glyphs) -->
        <Canvas x:Name="OcrLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Selection rectangle + 8 handles + size badge -->
        <Canvas x:Name="SelectionLayer"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <!-- Positioned via translate transform (render-only), not Margin —
                 Margin invalidates RootGrid layout on every pointer move. -->
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="SelectionTranslate" />
            </Canvas.RenderTransform>
            <Rectangle x:Name="SelectionBorder"
                       Stroke="{ThemeResource ClipsyAccentBrush}"
                       StrokeThickness="1.5"
                       IsHitTestVisible="False" />
            <Canvas x:Name="HandlesLayer" />
            <Rectangle x:Name="ScanLine"
                       Height="18"
                       Opacity="0.9"
                       Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#FFFFC107" Offset="0.4" />
                        <GradientStop Color="#FFFFC107" Offset="0.6" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="OcrStatusLabel"
                       Text="No text found"
                       Foreground="{ThemeResource ClipsyTextBrush}"
                       FontSize="16"
                       Visibility="Collapsed" />
            <Canvas x:Name="CursorPreviewLayer" IsHitTestVisible="False" />
        </Canvas>

        <!-- All floating toolbars / panels live above the selection. -->
        <Canvas x:Name="OverlayLayer">

            <!-- ============== Bottom toolbar (after selection) ============== -->
            <Border x:Name="BottomToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Bottom island: square 32x32 buttons; only Cancel is wider
                         (38x32) to fit its Esc label. -->
                    <Button x:Name="RecordBtn"
                            Style="{StaticResource ClipsyIconButtonDanger}"
                            Click="OnRecordClick"
                            ToolTipService.ToolTip="Record">
                        <Grid>
                            <Ellipse Width="18" Height="18"
                                   Stroke="{ThemeResource ClipsyDangerBrush}"
                                   StrokeThickness="2"
                                   Fill="Transparent" />
                            <Ellipse Width="10" Height="10"
                                   Fill="{ThemeResource ClipsyDangerBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ScreenshotBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnScreenshotClick"
                            ToolTipService.ToolTip="Screenshot">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                    </Button>
                    <Button x:Name="CopyBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnCopyClick"
                            ToolTipService.ToolTip="Copy">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    </Button>
                    <Border Style="{StaticResource ClipsyToolbarSeparator}" />
                    <!-- Wider, not taller (38x32): the Esc label needs horizontal
                         room, so the icon shifts right instead of down. -->
                    <Button x:Name="CancelBtn" Width="38"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnCancelClick"
                            ToolTipService.ToolTip="Cancel (Esc)"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <FontIcon Glyph="&#xE711;" FontSize="16" Margin="8,6,0,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Esc" FontSize="8" FontWeight="SemiBold" Opacity="0.65"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,2,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== OCR toolbar (visible while scanning, exit only) ============== -->
            <Border x:Name="OcrToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <Button x:Name="OcrExitBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnOcrExit"
                        ToolTipService.ToolTip="Exit OCR (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Border>

            <!-- ============== OCR panels (draggable, horizontal) ============== -->
            <StackPanel x:Name="OcrPanelsContainer"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">

                <Border x:Name="OcrTextPanel"
                        Background="{ThemeResource ClipsyBg1Brush}"
                        BorderBrush="{ThemeResource ClipsyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{ThemeResource ClipsyBg2Brush}"
                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="12,8"
                                PointerPressed="OnOcrPanelDragStart"
                                PointerMoved="OnOcrPanelDragMove"
                                PointerReleased="OnOcrPanelDragEnd"
                                PointerCaptureLost="OnOcrPanelDragCancel">
                            <TextBlock x:Name="OcrPanelTitle" Style="{StaticResource ClipsyLabel}" />
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="200" MaxWidth="480"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,10">
                            <TextBox x:Name="OcrTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{ThemeResource ClipsyTextBrush}"
                                     FontSize="13" />
                        </ScrollViewer>
                        <Border Grid.Row="2"
                                Background="{ThemeResource ClipsyBg2Brush}"
                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,8,8"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="OcrSelectAllBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrSelectAll"
                                        ToolTipService.ToolTip="Select all text">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="15" />
                                </Button>
                                <Button x:Name="OcrCopyBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrCopy"
                                        ToolTipService.ToolTip="Copy text">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                                </Button>
                                <Button x:Name="OcrTranslateBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrTranslate"
                                        ToolTipService.ToolTip="Translate">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="15" />
                                </Button>
                                <Border Style="{StaticResource ClipsyToolbarSeparator}" />
                                <Button Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrExit"
                                        ToolTipService.ToolTip="Exit OCR (Esc)">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="TranslatePanel"
                        Background="{ThemeResource ClipsyBg1Brush}"
                        BorderBrush="{ThemeResource ClipsyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{ThemeResource ClipsyBg2Brush}"
                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="12,6"
                                PointerPressed="OnOcrPanelDragStart"
                                PointerMoved="OnOcrPanelDragMove"
                                PointerReleased="OnOcrPanelDragEnd"
                                PointerCaptureLost="OnOcrPanelDragCancel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TranslatePanelTitle"
                                           Style="{StaticResource ClipsyLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />
                                <Button Grid.Column="1" x:Name="TranslateFromBtn"
                                        Click="OnTranslateFromBtnClick"
                                        Padding="8,3" MinWidth="44"
                                        Background="{ThemeResource ClipsyBg3Brush}"
                                        BorderThickness="0" CornerRadius="4"
                                        FontSize="11" FontWeight="SemiBold" />
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="10"
                                          Margin="6,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource ClipsyText3Brush}" />
                                <Button Grid.Column="3" x:Name="TranslateToBtn"
                                        Click="OnTranslateToBtnClick"
                                        Padding="8,3" MinWidth="44"
                                        Background="{ThemeResource ClipsyBg3Brush}"
                                        BorderThickness="0" CornerRadius="4"
                                        FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="220" MaxWidth="480"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,10">
                            <TextBox x:Name="TranslateTarget"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{ThemeResource ClipsyTextBrush}"
                                     FontSize="13" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ============== Right toolbar (annotation tools) ============== -->
            <Border x:Name="RightToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <Button x:Name="ColorBtn" Height="38"
                            Style="{StaticResource ClipsyIconButton}"
                            ToolTipService.ToolTip="Color">
                        <Ellipse x:Name="ColorSwatch" Width="18" Height="18" Margin="0,6,0,0"
                                 Fill="{ThemeResource ClipsyDangerBrush}"
                                 Stroke="White" StrokeThickness="1.5" />
                        <Button.Flyout>
                            <Flyout x:Name="ColorFlyout" Placement="Left"
                                    Opened="OnColorFlyoutOpened">
                                <StackPanel Spacing="8" Width="240">
                                    <ColorPicker x:Name="ColorPickerCtl"
                                                 ColorSpectrumShape="Box"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True"
                                                 IsAlphaEnabled="False"
                                                 IsMoreButtonVisible="False"
                                                 ColorChanged="OnColorPickerChanged" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="EyedropperBtn" Grid.Column="0"
                                                Click="OnEyedropperBtnClick"
                                                Style="{StaticResource ClipsyIconButton}"
                                                ToolTipService.ToolTip="Pick color from screen">
                                            <FontIcon Glyph="&#xEF3C;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="ColorCancelBtn" Grid.Column="2"
                                                Click="OnColorCancelClick"
                                                Style="{StaticResource ClipsyIconButton}"
                                                Margin="0,0,6,0"
                                                ToolTipService.ToolTip="Cancel">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="ColorConfirmBtn" Grid.Column="3"
                                                Click="OnColorConfirmClick"
                                                Style="{StaticResource ClipsyIconButton}"
                                                Background="{ThemeResource ClipsyAccentBrush}"
                                                ToolTipService.ToolTip="Apply">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="Black" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="PencilBtn" Height="38"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Pencil"
                            ToolTipService.ToolTip="Pencil. LMB draw, RMB erase"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <!-- Content stretched to the full button so the hotkey badge
                             pins to the button's own top-left corner, not the icon's. -->
                        <Grid>
                            <!-- Icon nudged below the badge chip's row so they never overlap -->
                            <FontIcon Glyph="&#xE70F;" FontSize="16" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="1" FontSize="8" FontWeight="SemiBold" Opacity="0.65"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,2,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                    <Button x:Name="TextBtn" Height="38"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnTextClick"
                            PointerEntered="OnTextPointerEntered"
                            PointerExited="OnTextPointerExited"
                            ToolTipService.ToolTip="Text. Click to place. Hover for font."
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <!-- Big T + small T (small caps style) -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TextBtnGlyph" Text="T" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="TextBtnGlyphSmall" Text="T" FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Bottom" Margin="1,0,0,1" />
                            </StackPanel>
                            <TextBlock Text="2" FontSize="8" FontWeight="SemiBold" Opacity="0.65"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,2,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                    <Button x:Name="ShapesBtn" Height="38"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapesClick"
                            PointerEntered="OnShapesPointerEntered"
                            PointerExited="OnShapesPointerExited"
                            ToolTipService.ToolTip="Shapes"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid x:Name="ShapeIconContainer" Width="16" Height="16" Margin="0,6,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="ShapeIconRect" Width="14" Height="14"
                                           Stroke="{ThemeResource ClipsyText2Brush}"
                                           StrokeThickness="1.5" />
                                <Ellipse x:Name="ShapeIconEllipse" Width="14" Height="14"
                                         Stroke="{ThemeResource ClipsyText2Brush}"
                                         StrokeThickness="1.5"
                                         Visibility="Collapsed" />
                                <Line x:Name="ShapeIconLine" X1="2" Y1="14" X2="14" Y2="2"
                                      Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5"
                                      Visibility="Collapsed" />
                                <Grid x:Name="ShapeIconArrow" Visibility="Collapsed">
                                    <Line x:Name="ShapeIconArrowLine" X1="2" Y1="14" X2="14" Y2="2"
                                          Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5" />
                                    <Polyline x:Name="ShapeIconArrowHead" Points="8,2 14,2 14,8"
                                              Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5"
                                              Fill="Transparent" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="3" FontSize="8" FontWeight="SemiBold" Opacity="0.65"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,2,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource ClipsyToolbarSeparatorHorizontal}" />
                    <Button x:Name="OcrBtn" Height="38"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnOcrClick"
                            ToolTipService.ToolTip="Find text"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid Width="18" Height="18" Margin="0,8,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                                <TextBlock Text="T" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,-2,-2,0" />
                            </Grid>
                            <TextBlock Text="4" FontSize="8" FontWeight="SemiBold" Opacity="0.65"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,2,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== Shapes flyout (programmatically positioned) ============== -->
            <Border x:Name="ShapesFlyout"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed"
                    PointerEntered="OnShapesFlyoutPointerEntered"
                    PointerExited="OnShapesFlyoutPointerExited">
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,2">
                    <Button x:Name="RectBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Rectangle"
                            ToolTipService.ToolTip="Rectangle">
                        <Rectangle Width="14" Height="14"
                                   Stroke="{ThemeResource ClipsyText2Brush}"
                                   StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="EllipseBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Ellipse"
                            ToolTipService.ToolTip="Ellipse">
                        <Ellipse Width="14" Height="14"
                                 Stroke="{ThemeResource ClipsyText2Brush}"
                                 StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="LineBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Line"
                            ToolTipService.ToolTip="Line">
                        <Line X1="2" Y1="14" X2="14" Y2="2"
                              Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="ArrowBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Arrow"
                            ToolTipService.ToolTip="Arrow">
                        <Grid>
                            <Line X1="2" Y1="14" X2="14" Y2="2"
                                  Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5" />
                            <Polyline Points="8,2 14,2 14,8"
                                      Stroke="{ThemeResource ClipsyText2Brush}" StrokeThickness="1.5"
                                      Fill="Transparent" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== Fonts flyout (mirrors ShapesFlyout) ============== -->
            <!-- Items populated from system-installed fonts in code-behind on
                 first hover so we don't query GDI at XAML load time. -->
            <Border x:Name="FontsFlyout"
                    Style="{StaticResource ClipsyToolbar}"
                    MinWidth="220" MaxHeight="360"
                    Visibility="Collapsed"
                    PointerEntered="OnFontsFlyoutPointerEntered"
                    PointerExited="OnFontsFlyoutPointerExited">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FontFilterBox"
                             Grid.Row="0"
                             PlaceholderText="Filter…"
                             Margin="0,0,0,4"
                             TextChanged="OnFontFilterChanged" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,14,0">
                        <StackPanel x:Name="FontList" Spacing="0" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>

        <!-- ============== Hint (shown when no selection yet) ============== -->
        <Border x:Name="Hint"
                Background="{ThemeResource ClipsyBg1Brush}"
                BorderBrush="{ThemeResource ClipsyBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,72,0,0"
                Opacity="0"
                IsHitTestVisible="False">
            <!-- Starts hidden above its spot; the intro animation slides it in.
                 Initial values match the animation's From so the pre-composed
                 first frame shows nothing. -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="HintTranslate" Y="-56" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- HintText carries the localized string set from code-behind
                     (was Hint.Text on the old TextBlock). -->
                <TextBlock x:Name="HintText"
                           Text="Drag to select"
                           Foreground="{ThemeResource ClipsyTextBrush}"
                           FontSize="14" FontWeight="SemiBold" />
                <Border Width="1" Background="{ThemeResource ClipsyBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="Ctrl" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="A" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <TextBlock x:Name="HintFullScreenLabel" Text="full screen"
                               Foreground="{ThemeResource ClipsyText2Brush}" FontSize="12" />
                </StackPanel>
                <Border Width="1" Background="{ThemeResource ClipsyBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="Esc" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <TextBlock x:Name="HintCancelLabel" Text="cancel"
                               Foreground="{ThemeResource ClipsyText2Brush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============== Eyedropper magnifier ============== -->
        <Grid x:Name="EyedropperMagnifier"
              Width="128" Height="128"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Ellipse Width="128" Height="128" Fill="Black" />
            <!-- Magnified pixels painted through an ImageBrush so the Ellipse
                 clips the square WriteableBitmap into a clean circle. -->
            <Ellipse Width="128" Height="128">
                <Ellipse.Fill>
                    <ImageBrush x:Name="MagBrush" Stretch="Fill" />
                </Ellipse.Fill>
            </Ellipse>
            <!-- Outer ring: dark backing + bright white border so the circle
                 edge stays visible over any content. -->
            <Ellipse Width="128" Height="128" Stroke="Black" StrokeThickness="4" Fill="Transparent" />
            <Ellipse Width="128" Height="128" Stroke="White" StrokeThickness="2" Fill="Transparent" />
            <!-- Centre crosshair marking the sampled pixel. -->
            <Border Width="14" Height="14" BorderBrush="Black" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="12" Height="12" BorderBrush="White" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Context menu (RMB) — selection / actions / cancel grouped with
             separators. Icons left, accelerator hint right. -->
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="OverlayMenu">
                <!-- Selection group -->
                <MenuFlyoutSubItem x:Name="SelectScreenMenu" Text="Select screen">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="MenuSelectAll" Text="Select all"
                                KeyboardAcceleratorTextOverride="Ctrl+A"
                                Click="OnMenuSelectAll">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE739;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Actions group (visible only with a selection) -->
                <MenuFlyoutSeparator x:Name="SelectionMenuSeparator" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="MenuCopy" Text="Copy" Visibility="Collapsed"
                                KeyboardAcceleratorTextOverride="Ctrl+C"
                                Click="OnMenuCopy">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuSave" Text="Save" Visibility="Collapsed"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Click="OnMenuSave">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuSaveAs" Text="Save As…" Visibility="Collapsed"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Click="OnMenuSaveAs">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuClear" Text="Clear drawings" Visibility="Collapsed"
                                Click="OnMenuClear">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE75C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Cancel group -->
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuCancel" Text="Cancel"
                                KeyboardAcceleratorTextOverride="Esc"
                                Click="OnMenuCancel">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
    </Grid>
</Window>
