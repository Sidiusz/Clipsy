<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · Capture overlay
  Same layout & x:Names as before; the styling delta is that toolbars,
  buttons, and panels all pull from Clipsy.Tokens / Clipsy.Styles via the
  shared resource dictionary. No hard-coded #F01E1E1E / #FF2E2E2E anymore.

  All existing event handlers (OnRecordClick, OnScreenshotClick, etc.)
  keep their names so code-behind continues to compile.
-->
<Window
    x:Class="Clipsy.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          IsTabStop="True"
          KeyDown="OnKeyDown"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased"
          PointerWheelChanged="OnRootPointerWheelChanged"
          RightTapped="OnRootRightTapped">

        <!-- Frozen desktop -->
        <Image x:Name="FrozenImage"
               Stretch="None"
               Opacity="1.0"
               IsHitTestVisible="False" />

        <!-- Even-odd dim cut-out for the selected region -->
        <Path x:Name="DimPath"
              Fill="{StaticResource ClipsyOverlayDimBrush}"
              IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup x:Name="DimGeometry" FillRule="EvenOdd" />
            </Path.Data>
        </Path>

        <!-- Drawings live in root DIPs (kept anchored on resize). -->
        <Canvas x:Name="DrawingCanvas"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- OCR overlay (yellow rects + clean glyphs) -->
        <Canvas x:Name="OcrLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Selection rectangle + 8 handles + size badge -->
        <Canvas x:Name="SelectionLayer"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <Rectangle x:Name="SelectionBorder"
                       Stroke="{StaticResource ClipsyAccentBrush}"
                       StrokeThickness="1.5"
                       IsHitTestVisible="False" />
            <Canvas x:Name="HandlesLayer" />
            <Rectangle x:Name="ScanLine"
                       Height="18"
                       Opacity="0.9"
                       Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#FFFFC107" Offset="0.4" />
                        <GradientStop Color="#FFFFC107" Offset="0.6" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="OcrStatusLabel"
                       Text="No text found"
                       Foreground="{StaticResource ClipsyTextBrush}"
                       FontSize="16"
                       Visibility="Collapsed" />
            <Canvas x:Name="CursorPreviewLayer" IsHitTestVisible="False" />
        </Canvas>

        <!-- All floating toolbars / panels live above the selection. -->
        <Canvas x:Name="OverlayLayer">

            <!-- ============== Bottom toolbar (after selection) ============== -->
            <Border x:Name="BottomToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="RecordBtn"
                            Style="{StaticResource ClipsyIconButtonDanger}"
                            Click="OnRecordClick"
                            ToolTipService.ToolTip="Record">
                        <Grid>
                            <Ellipse Width="18" Height="18"
                                   Stroke="{StaticResource ClipsyDangerBrush}"
                                   StrokeThickness="2"
                                   Fill="Transparent" />
                            <Ellipse Width="10" Height="10"
                                   Fill="{StaticResource ClipsyDangerBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ScreenshotBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnScreenshotClick"
                            ToolTipService.ToolTip="Screenshot">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                    </Button>
                    <Button x:Name="CopyBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnCopyClick"
                            ToolTipService.ToolTip="Copy">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    </Button>
                    <Border Style="{StaticResource ClipsyToolbarSeparator}" />
                    <Button x:Name="CancelBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnCancelClick"
                            ToolTipService.ToolTip="Cancel (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== OCR toolbar (visible while scanning, exit only) ============== -->
            <Border x:Name="OcrToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <Button x:Name="OcrExitBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnOcrExit"
                        ToolTipService.ToolTip="Exit OCR (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Border>

            <!-- ============== OCR panels (draggable, horizontal) ============== -->
            <StackPanel x:Name="OcrPanelsContainer"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">

                <Border x:Name="OcrTextPanel"
                        Background="{StaticResource ClipsyBg1Brush}"
                        BorderBrush="{StaticResource ClipsyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource ClipsyBg2Brush}"
                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="12,8"
                                PointerPressed="OnOcrPanelDragStart"
                                PointerMoved="OnOcrPanelDragMove"
                                PointerReleased="OnOcrPanelDragEnd"
                                PointerCaptureLost="OnOcrPanelDragCancel">
                            <TextBlock x:Name="OcrPanelTitle" Style="{StaticResource ClipsyLabel}" />
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="200" MaxWidth="480"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,10">
                            <TextBox x:Name="OcrTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource ClipsyTextBrush}"
                                     FontSize="13" />
                        </ScrollViewer>
                        <Border Grid.Row="2"
                                Background="{StaticResource ClipsyBg2Brush}"
                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,8,8"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="OcrSelectAllBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrSelectAll"
                                        ToolTipService.ToolTip="Select all text">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="15" />
                                </Button>
                                <Button x:Name="OcrCopyBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrCopy"
                                        ToolTipService.ToolTip="Copy text">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                                </Button>
                                <Button x:Name="OcrTranslateBtn"
                                        Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrTranslate"
                                        ToolTipService.ToolTip="Translate">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="15" />
                                </Button>
                                <Border Style="{StaticResource ClipsyToolbarSeparator}" />
                                <Button Style="{StaticResource ClipsyIconButton}"
                                        Click="OnOcrExit"
                                        ToolTipService.ToolTip="Exit OCR (Esc)">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="TranslatePanel"
                        Background="{StaticResource ClipsyBg1Brush}"
                        BorderBrush="{StaticResource ClipsyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource ClipsyBg2Brush}"
                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="12,8"
                                PointerPressed="OnOcrPanelDragStart"
                                PointerMoved="OnOcrPanelDragMove"
                                PointerReleased="OnOcrPanelDragEnd"
                                PointerCaptureLost="OnOcrPanelDragCancel">
                            <TextBlock x:Name="TranslatePanelTitle" Style="{StaticResource ClipsyLabel}" />
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="220" MaxWidth="480"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="12,10">
                            <TextBox x:Name="TranslateTarget"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource ClipsyTextBrush}"
                                     FontSize="13" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ============== Right toolbar (annotation tools) ============== -->
            <Border x:Name="RightToolbar"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <Button x:Name="ColorBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            ToolTipService.ToolTip="Color">
                        <Ellipse x:Name="ColorSwatch" Width="18" Height="18"
                                 Fill="{StaticResource ClipsyDangerBrush}"
                                 Stroke="White" StrokeThickness="1.5" />
                        <Button.Flyout>
                            <Flyout Placement="Left">
                                <ColorPicker x:Name="ColorPickerCtl"
                                             Color="#FFF23F42"
                                             IsColorChannelTextInputVisible="True"
                                             IsHexInputVisible="True"
                                             IsAlphaEnabled="False"
                                             IsMoreButtonVisible="True"
                                             ColorChanged="OnColorPickerChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="PencilBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Pencil"
                            ToolTipService.ToolTip="Pencil. LMB draw, RMB erase">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                    <Button x:Name="TextBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnTextClick"
                            PointerEntered="OnTextPointerEntered"
                            PointerExited="OnTextPointerExited"
                            ToolTipService.ToolTip="Text. Click to place. Hover for font.">
                        <TextBlock x:Name="TextBtnGlyph" Text="T" FontWeight="SemiBold" FontSize="14" />
                    </Button>
                    <Button x:Name="ShapesBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapesClick"
                            PointerEntered="OnShapesPointerEntered"
                            PointerExited="OnShapesPointerExited"
                            ToolTipService.ToolTip="Shapes">
                        <Grid x:Name="ShapeIconContainer">
                            <Rectangle x:Name="ShapeIconRect" Width="14" Height="14"
                                       Stroke="{StaticResource ClipsyText2Brush}"
                                       StrokeThickness="1.5" />
                            <Ellipse x:Name="ShapeIconEllipse" Width="14" Height="14"
                                     Stroke="{StaticResource ClipsyText2Brush}"
                                     StrokeThickness="1.5"
                                     Visibility="Collapsed" />
                            <Line x:Name="ShapeIconLine" X1="2" Y1="14" X2="14" Y2="2"
                                  Stroke="{StaticResource ClipsyText2Brush}" StrokeThickness="1.5"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource ClipsyToolbarSeparatorHorizontal}" />
                    <Button x:Name="OcrBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnOcrClick"
                            ToolTipService.ToolTip="Find text">
                        <Grid>
                            <FontIcon Glyph="&#xE721;" FontSize="16" />
                            <TextBlock Text="T" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,-2,-2,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== Shapes flyout (programmatically positioned) ============== -->
            <Border x:Name="ShapesFlyout"
                    Style="{StaticResource ClipsyToolbar}"
                    Visibility="Collapsed"
                    PointerEntered="OnShapesFlyoutPointerEntered"
                    PointerExited="OnShapesFlyoutPointerExited">
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,2">
                    <Button x:Name="RectBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Rectangle"
                            ToolTipService.ToolTip="Rectangle">
                        <Rectangle Width="14" Height="14"
                                   Stroke="{StaticResource ClipsyText2Brush}"
                                   StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="EllipseBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Ellipse"
                            ToolTipService.ToolTip="Ellipse">
                        <Ellipse Width="14" Height="14"
                                 Stroke="{StaticResource ClipsyText2Brush}"
                                 StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="LineBtn"
                            Style="{StaticResource ClipsyIconButton}"
                            Click="OnShapePick" Tag="Line"
                            ToolTipService.ToolTip="Line">
                        <Line X1="2" Y1="14" X2="14" Y2="2"
                              Stroke="{StaticResource ClipsyText2Brush}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============== Fonts flyout (mirrors ShapesFlyout) ============== -->
            <!-- Items populated from system-installed fonts in code-behind on
                 first hover so we don't query GDI at XAML load time. -->
            <Border x:Name="FontsFlyout"
                    Style="{StaticResource ClipsyToolbar}"
                    MinWidth="220" MaxHeight="360"
                    Visibility="Collapsed"
                    PointerEntered="OnFontsFlyoutPointerEntered"
                    PointerExited="OnFontsFlyoutPointerExited">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FontFilterBox"
                             Grid.Row="0"
                             PlaceholderText="Filter…"
                             Margin="0,0,0,4"
                             TextChanged="OnFontFilterChanged" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FontList" Spacing="0" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>

        <!-- ============== Hint (shown when no selection yet) ============== -->
        <Border x:Name="Hint"
                Background="{StaticResource ClipsyBg1Brush}"
                BorderBrush="{StaticResource ClipsyBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,72,0,0"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- HintText carries the localized string set from code-behind
                     (was Hint.Text on the old TextBlock). -->
                <TextBlock x:Name="HintText"
                           Text="Drag to select"
                           Foreground="{StaticResource ClipsyTextBrush}"
                           FontSize="14" FontWeight="SemiBold" />
                <Border Width="1" Background="{StaticResource ClipsyBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="Ctrl" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="A" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <TextBlock Text="full screen"
                               Foreground="{StaticResource ClipsyText2Brush}" FontSize="12" />
                </StackPanel>
                <Border Width="1" Background="{StaticResource ClipsyBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource ClipsyKbd}">
                        <TextBlock Text="Esc" Style="{StaticResource ClipsyMono}" />
                    </Border>
                    <TextBlock Text="cancel"
                               Foreground="{StaticResource ClipsyText2Brush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Context menu (unchanged shape; styles inherit from theme) -->
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="OverlayMenu">
                <MenuFlyoutSubItem x:Name="SelectScreenMenu" Text="Select screen" />
                <MenuFlyoutItem x:Name="MenuSelectAll" Text="Select all" Click="OnMenuSelectAll" />
                <MenuFlyoutSeparator x:Name="SelectionMenuSeparator" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="MenuCopy" Text="Copy" Click="OnMenuCopy" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="MenuSave" Text="Save" Click="OnMenuSave" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="MenuSaveAs" Text="Save As" Click="OnMenuSaveAs" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="MenuClear" Text="Clear" Click="OnMenuClear" Visibility="Collapsed" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuCancel" Text="Cancel" Click="OnMenuCancel" />
            </MenuFlyout>
        </Grid.ContextFlyout>
    </Grid>
</Window>
