<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{StaticResource ClipsyBg2Brush}"
          Width="264">
        <StackPanel Padding="6,6,6,4">

            <!-- ── Header ── -->
            <Grid Margin="2,4,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{StaticResource ClipsyAccentBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                            VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Clipsy" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ClipsyTextBrush}"
                               FontFamily="{StaticResource ClipsyFontFamily}"/>
                    <TextBlock x:Name="HeaderStatus" Text="ready" FontSize="11"
                               Foreground="{StaticResource ClipsyText3Brush}"
                               FontFamily="{StaticResource ClipsyFontFamily}"/>
                </StackPanel>
            </Grid>

            <!-- ── Separator 1 ── -->
            <Rectangle Height="1" Margin="2,0,2,4"
                       Fill="{StaticResource ClipsyBorderBrush}" Opacity="0.7"/>

            <!-- ── Capture screen ── -->
            <Grid x:Name="CaptureRow" Height="34" Margin="0,1" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnCaptureClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="CaptureIcon" Glyph="&#xE722;" FontSize="15"
                          Foreground="{StaticResource ClipsyText2Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="CaptureTxt" Grid.Column="1" Text="Capture screen"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="CaptureShortcut" Grid.Column="2" Text="PrtSc"
                           FontSize="11" Foreground="{StaticResource ClipsyText3Brush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>

            <!-- ── Record region ── -->
            <Grid x:Name="RecordRow" Height="34" Margin="0,1" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnRecordClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="RecordDot" Width="10" Height="10"
                         Fill="{StaticResource ClipsyText2Brush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecordTxt" Grid.Column="1" Text="Record region"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="RecordShortcut" Grid.Column="2" Text="Ctrl &#x21E7; R"
                           FontSize="11" Foreground="{StaticResource ClipsyText3Brush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>

            <!-- ── Open captures folder ── -->
            <Grid x:Name="FolderRow" Height="34" Margin="0,1" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnOpenFolderClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="FolderIcon" Glyph="&#xE8B7;" FontSize="15"
                          Foreground="{StaticResource ClipsyText2Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="FolderTxt" Grid.Column="1" Text="Open captures folder"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Separator 2 ── -->
            <Rectangle Height="1" Margin="2,4,2,4"
                       Fill="{StaticResource ClipsyBorderBrush}" Opacity="0.7"/>

            <!-- ── Settings ── -->
            <Grid x:Name="SettingsRow" Height="34" Margin="0,1" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnSettingsClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="15"
                          Foreground="{StaticResource ClipsyText2Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="SettingsTxt" Grid.Column="1" Text="Settings"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SettingsShortcut" Grid.Column="2" Text="Ctrl ,"
                           FontSize="11" Foreground="{StaticResource ClipsyText3Brush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>

            <!-- ── About ── -->
            <Grid x:Name="AboutRow" Height="34" Margin="0,1" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnAboutClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="AboutIcon" Glyph="&#xE946;" FontSize="15"
                          Foreground="{StaticResource ClipsyText2Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="AboutTxt" Grid.Column="1" Text="About"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Separator 3 ── -->
            <Rectangle Height="1" Margin="2,4,2,4"
                       Fill="{StaticResource ClipsyBorderBrush}" Opacity="0.7"/>

            <!-- ── Exit ── -->
            <Grid x:Name="ExitRow" Height="34" Margin="0,1,0,2" CornerRadius="6"
                  Background="Transparent"
                  Tapped="OnExitClick"
                  PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                  PointerPressed="OnItemPointerPressed" PointerReleased="OnItemPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="ExitIcon" Glyph="&#xE711;" FontSize="15"
                          Foreground="{StaticResource ClipsyText2Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="ExitTxt" Grid.Column="1" Text="Exit"
                           FontSize="13" Foreground="{StaticResource ClipsyTextBrush}"
                           FontFamily="{StaticResource ClipsyFontFamily}"
                           VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
