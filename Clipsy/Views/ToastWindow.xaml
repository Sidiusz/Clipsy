<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="CardBorder"
                Background="{ThemeResource ClipsyBg2Brush}"
                BorderBrush="{ThemeResource ClipsyBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="380"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited">
            <Grid>
                <!-- Left accent strip (clipped to border radius by the parent) -->
                <Rectangle x:Name="AccentBar"
                           Width="4"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch" />

                <!-- Main content -->
                <Grid Margin="20,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontFamily="{StaticResource ClipsyFontFamily}"
                                   FontSize="13"
                                   FontWeight="{StaticResource ClipsyFontWeightStrong}"
                                   Foreground="{ThemeResource ClipsyTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="BodyText"
                                   FontFamily="{StaticResource ClipsyFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource ClipsyText3Brush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button x:Name="Action1Btn"
                                Style="{StaticResource ClipsyButtonGhost}"
                                Width="28" Height="28" Padding="0"
                                Visibility="Collapsed"
                                Click="OnAction1Click" />
                        <Button x:Name="Action2Btn"
                                Style="{StaticResource ClipsyButtonGhost}"
                                Width="28" Height="28" Padding="0"
                                Visibility="Collapsed"
                                Click="OnAction2Click" />
                        <Button x:Name="CloseBtn"
                                Style="{StaticResource ClipsyButtonGhost}"
                                Width="28" Height="28" Padding="0"
                                Click="OnCloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
