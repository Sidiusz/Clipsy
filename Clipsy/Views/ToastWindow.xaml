<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="CardBorder"
            Background="{StaticResource ClipsyBg2Brush}"
            BorderBrush="{StaticResource ClipsyBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            Opacity="0"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="20" />
        </Border.RenderTransform>

        <Grid>
            <!-- Left accent strip -->
            <Rectangle x:Name="AccentBar"
                       Width="4"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch" />

            <!-- Main content -->
            <Grid Margin="20,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Level icon -->
                <FontIcon x:Name="LevelIcon"
                          Grid.Column="0"
                          FontSize="16"
                          VerticalAlignment="Top"
                          Margin="0,1,10,0" />

                <!-- Title + body -->
                <StackPanel Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontFamily="{StaticResource ClipsyFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ClipsyTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BodyText"
                               FontFamily="{StaticResource ClipsyFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource ClipsyText3Brush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Action buttons + close -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Button x:Name="Action1Btn"
                            Style="{StaticResource ClipsyButtonGhost}"
                            Width="28" Height="28" Padding="0"
                            Visibility="Collapsed"
                            Click="OnAction1Click" />
                    <Button x:Name="Action2Btn"
                            Style="{StaticResource ClipsyButtonGhost}"
                            Width="28" Height="28" Padding="0"
                            Visibility="Collapsed"
                            Click="OnAction2Click" />
                    <Button x:Name="CloseBtn"
                            Style="{StaticResource ClipsyButtonGhost}"
                            Width="28" Height="28" Padding="0"
                            Click="OnCloseClick">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
