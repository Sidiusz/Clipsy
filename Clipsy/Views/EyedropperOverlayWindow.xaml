<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · Eyedropper Overlay
  Fullscreen transparent WinUI window for screen-colour picking.
  Shared by CaptureOverlayWindow (canvas) and HudColorPickerWindow (recording).
  Excluded from screen capture via SetWindowDisplayAffinity.
-->
<Window
    x:Class="Clipsy.Views.EyedropperOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerMoved="OnPointerMoved"
          PointerPressed="OnPointerPressed">

        <!-- Frozen screenshot rendered as background so the user sees the actual
             screen content while picking. Filled synchronously from decoded pixels
             before the window activates — no blank/black frame. -->
        <Image x:Name="FrameImage" Stretch="Fill" IsHitTestVisible="False" />

        <!-- ── Magnifier loupe (identical visual to CaptureOverlayWindow) ── -->
        <Grid x:Name="EyedropperMagnifier"
              Width="128" Height="128"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MagTransform" />
            </Grid.RenderTransform>
            <Ellipse Width="128" Height="128" Fill="Black" />
            <!-- Magnified pixels painted through an ImageBrush so the Ellipse
                 clips the square WriteableBitmap into a clean circle. -->
            <Ellipse Width="128" Height="128">
                <Ellipse.Fill>
                    <ImageBrush x:Name="MagBrush" Stretch="Fill" />
                </Ellipse.Fill>
            </Ellipse>
            <!-- Outer ring: dark backing + bright white border. -->
            <Ellipse Width="128" Height="128" Stroke="Black" StrokeThickness="4" Fill="Transparent" />
            <Ellipse Width="128" Height="128" Stroke="White" StrokeThickness="2" Fill="Transparent" />
            <!-- Centre crosshair marking the sampled pixel. -->
            <Border Width="14" Height="14" BorderBrush="Black" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="12" Height="12" BorderBrush="White" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

    </Grid>
</Window>
