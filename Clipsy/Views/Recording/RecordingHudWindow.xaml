<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.Recording.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Resources>
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Border x:Name="Root"
                Background="#F01E1E1E"
                BorderBrush="#FF2E2E2E"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="TimerText"
                           Text="00:00"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Width="56"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />
                <Button x:Name="PauseBtn" Style="{StaticResource ToolButtonStyle}" Click="OnPauseClick" ToolTipService.ToolTip="Pause">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="18" />
                </Button>
                <Button x:Name="StopBtn" Style="{StaticResource ToolButtonStyle}" Click="OnStopClick" ToolTipService.ToolTip="Stop and save to last folder">
                    <FontIcon Glyph="&#xE71A;" Foreground="#FFE05151" FontSize="18" />
                </Button>
                <Button x:Name="StopSaveBtn" Style="{StaticResource ToolButtonStyle}" Click="OnStopSaveClick" ToolTipService.ToolTip="Stop and Save As">
                    <FontIcon Glyph="&#xE74E;" FontSize="18" />
                </Button>
                <ToggleButton x:Name="DrawBtn" Style="{StaticResource ToolToggleStyle}" Click="OnDrawToggle" ToolTipService.ToolTip="Draw">
                    <FontIcon Glyph="&#xE70F;" FontSize="18" />
                </ToggleButton>
                <Button x:Name="MoveBtn"
                        Style="{StaticResource ToolButtonStyle}"
                        Visibility="Collapsed"
                        PointerPressed="OnMovePointerPressed"
                        PointerMoved="OnMovePointerMoved"
                        PointerReleased="OnMovePointerReleased"
                        ToolTipService.ToolTip="Hold to drag region">
                    <FontIcon Glyph="&#xE7C2;" FontSize="18" />
                </Button>
                <Button x:Name="LockBtn"
                        Style="{StaticResource ToolButtonStyle}"
                        DoubleTapped="OnLockDoubleTapped"
                        ToolTipService.ToolTip="Double-click to lock/unlock region">
                    <FontIcon x:Name="LockIcon" Glyph="&#xE72E;" FontSize="18" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
