<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · Recording HUD
  Pill bar shown below the active capture region. Auto-fades to ~35% when
  the cursor is far. All visual tokens come from Clipsy.Tokens / Styles.
-->
<Window
    x:Class="Clipsy.Views.Recording.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="HudRoot" Background="{StaticResource ClipsyBg1Brush}">
        <Border x:Name="Root" Style="{StaticResource ClipsyToolbar}" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <!-- Timer + REC dot -->
                <Border BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,0,10,0"
                        Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Height="32">
                        <Ellipse x:Name="RecDot"
                                 Width="8" Height="8"
                                 Fill="{StaticResource ClipsyDangerBrush}" />
                        <TextBlock x:Name="TimerText"
                                   Text="00:00"
                                   Foreground="{StaticResource ClipsyTextBrush}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="13"
                                   FontWeight="{StaticResource ClipsyFontWeightStrong}"
                                   MinWidth="44"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="PauseBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnPauseClick"
                        ToolTipService.ToolTip="Pause">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="16" />
                </Button>
                <Button x:Name="StopBtn"
                        Style="{StaticResource ClipsyIconButtonDanger}"
                        Click="OnStopClick"
                        ToolTipService.ToolTip="Stop and save to last folder">
                    <Rectangle Width="10" Height="10" Fill="{StaticResource ClipsyDangerBrush}" />
                </Button>
                <Button x:Name="StopSaveBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnStopSaveClick"
                        ToolTipService.ToolTip="Stop and Save As">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                </Button>
                <Button x:Name="CancelBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnCancelClick"
                        ToolTipService.ToolTip="Cancel recording (discard)">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>

                <Border Style="{StaticResource ClipsyToolbarSeparator}" />

                <ToggleButton x:Name="DrawBtn"
                              Style="{StaticResource ClipsyIconToggle}"
                              Click="OnDrawToggle"
                              ToolTipService.ToolTip="Draw">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="DrawColorBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        Click="OnDrawColorBtnClick"
                        ToolTipService.ToolTip="Pen color">
                    <Ellipse x:Name="DrawColorSwatch" Width="16" Height="16"
                             Fill="{StaticResource ClipsyDangerBrush}"
                             Stroke="White" StrokeThickness="1.5" />
                </Button>

                <Border x:Name="MicSep" Style="{StaticResource ClipsyToolbarSeparator}" Visibility="Collapsed" />
                <ToggleButton x:Name="MicBtn"
                              Style="{StaticResource ClipsyIconToggle}"
                              IsChecked="True"
                              Click="OnMicToggle"
                              Visibility="Collapsed"
                              ToolTipService.ToolTip="Microphone on">
                    <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="16" />
                </ToggleButton>

                <Button x:Name="LockBtn"
                        Style="{StaticResource ClipsyIconButton}"
                        DoubleTapped="OnLockDoubleTapped"
                        ToolTipService.ToolTip="Double-click to lock/unlock region">
                    <FontIcon x:Name="LockIcon" Glyph="&#xE72E;" FontSize="16" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
