<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · HUD Color Picker
  Floating window opened by the recording HUD's pen-color button.
  Lives in its own HWND so it isn't clipped by the HUD's layered window.
  SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) keeps it out of the recording.
  Content is the shared ColorPickerPanel UserControl (no eyedropper for recording).
-->
<Window
    x:Class="Clipsy.Views.Recording.HudColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Clipsy.Views">

    <Border x:Name="Root"
            Background="{ThemeResource ClipsyBg1Brush}"
            BorderBrush="{ThemeResource ClipsyBorderBrush}"
            BorderThickness="1"
            Padding="12"
            VerticalAlignment="Top">
        <views:ColorPickerPanel x:Name="ColorPickerCtl" />
    </Border>
</Window>
