<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ClipsyBg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{ThemeResource ClipsyBg0Brush}"
              BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                <Image Width="20" Height="20" Source="ms-appx:///Assets/Icons/clipsy-32.png" />
                <TextBlock Text="Clipsy" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}"
                           Foreground="{ThemeResource ClipsyTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="14" Foreground="{ThemeResource ClipsyText3Brush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarLabel" Text="Changelog" FontSize="13"
                           Foreground="{ThemeResource ClipsyText2Brush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4" Padding="20,16,20,12">
            <TextBlock x:Name="TitleLabel" Text="Changelog"
                       Style="{StaticResource ClipsySectionTitle}" />
            <TextBlock x:Name="HeaderLabel" Style="{StaticResource ClipsyHelper}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReleaseList" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Window>
