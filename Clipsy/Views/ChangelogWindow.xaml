<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ClipsyBg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Padding="20,16,20,12">
            <TextBlock x:Name="TitleLabel" Text="Changelog"
                       Style="{StaticResource ClipsySectionTitle}" />
            <TextBlock x:Name="HeaderLabel" Style="{StaticResource ClipsyHelper}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReleaseList" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Window>
