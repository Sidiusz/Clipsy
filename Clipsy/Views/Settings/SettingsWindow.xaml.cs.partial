// Clipsy · SettingsWindow code-behind additions
// =================================================================
// You already have most of this file. Below are ONLY the new pieces
// you need to add to support the sidebar nav and the inline hotkey
// rebind. Keep your existing constructor / load / save logic.
//
// Drop into: Clipsy/Views/Settings/SettingsWindow.xaml.cs

using System;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Runtime.CompilerServices;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Input;
using Microsoft.UI.Xaml.Media;
using Windows.System;

namespace Clipsy.Views.Settings
{
    public sealed partial class SettingsWindow
    {
        // ---------------------------------------------------------
        // Sidebar nav — swap the visible pane.
        // ---------------------------------------------------------
        private void OnNavSelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            if (NavList?.SelectedItem is not ListViewItem item) return;
            var key = item.Tag as string;

            PaneGeneral.Visibility = key == "general" ? Visibility.Visible : Visibility.Collapsed;
            PaneVideo.Visibility   = key == "video"   ? Visibility.Visible : Visibility.Collapsed;
            PaneGif.Visibility     = key == "gif"     ? Visibility.Visible : Visibility.Collapsed;
            PaneHotkeys.Visibility = key == "hotkeys" ? Visibility.Visible : Visibility.Collapsed;
            PaneInfo.Visibility    = key == "info"    ? Visibility.Visible : Visibility.Collapsed;
        }

        // ---------------------------------------------------------
        // Inline hotkey rebind.
        // ---------------------------------------------------------
        // Replace your previous HotkeyEntry record with this one — it
        // exposes IsRebinding plus the derived brush/visibility props
        // the DataTemplate binds against. INotifyPropertyChanged makes
        // the binding swap take effect when the user clicks a row.
        public sealed class HotkeyEntry : INotifyPropertyChanged
        {
            public string Key { get; init; } = "";    // stable id
            public string Label { get; init; } = "";  // shown in left col

            private string _binding = "";
            public string Binding
            {
                get => _binding;
                set { if (_binding != value) { _binding = value; OnChanged(); } }
            }

            private bool _isRebinding;
            public bool IsRebinding
            {
                get => _isRebinding;
                set
                {
                    if (_isRebinding == value) return;
                    _isRebinding = value;
                    OnChanged();
                    OnChanged(nameof(IdleVisibility));
                    OnChanged(nameof(RebindingVisibility));
                    OnChanged(nameof(RowBackground));
                    OnChanged(nameof(BindingBackground));
                    OnChanged(nameof(BindingBorderBrush));
                    OnChanged(nameof(BindingForeground));
                }
            }

            // Convenience derived bindings used by the row template.
            public Visibility IdleVisibility      => IsRebinding ? Visibility.Collapsed : Visibility.Visible;
            public Visibility RebindingVisibility => IsRebinding ? Visibility.Visible : Visibility.Collapsed;

            public Brush RowBackground =>
                IsRebinding
                    ? (Brush)Application.Current.Resources["ClipsyAccentDimBrush"]
                    : new SolidColorBrush(Microsoft.UI.Colors.Transparent);

            public Brush BindingBackground =>
                IsRebinding
                    ? (Brush)Application.Current.Resources["ClipsyBgInputBrush"]
                    : new SolidColorBrush(Microsoft.UI.Colors.Transparent);

            public Brush BindingBorderBrush =>
                IsRebinding
                    ? (Brush)Application.Current.Resources["ClipsyAccentBrush"]
                    : (Brush)Application.Current.Resources["ClipsyBorderBrush"];

            public Brush BindingForeground =>
                IsRebinding
                    ? (Brush)Application.Current.Resources["ClipsyAccentBrush"]
                    : (Brush)Application.Current.Resources["ClipsyText2Brush"];

            public event PropertyChangedEventHandler? PropertyChanged;
            private void OnChanged([CallerMemberName] string? name = null)
                => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name ?? ""));
        }

        // Backing collection — populate from your Hotkeys service in
        // the constructor:
        //   HotkeyList.ItemsSource = _hotkeys;
        private readonly ObservableCollection<HotkeyEntry> _hotkeys = new();

        // The row Button.Click handler. The DataTemplate sets
        // Tag={Binding Key} so we can find which row was clicked.
        private HotkeyEntry? _activeRebind;
        private void OnHotkeyRebindClick(object sender, RoutedEventArgs e)
        {
            if (sender is not Button btn) return;
            var key = btn.Tag as string;
            if (string.IsNullOrEmpty(key)) return;

            // Find the entry.
            HotkeyEntry? entry = null;
            foreach (var h in _hotkeys) if (h.Key == key) { entry = h; break; }
            if (entry is null) return;

            // Toggle off if already listening on this row, otherwise
            // cancel any other listener and start this one.
            if (_activeRebind == entry)
            {
                CancelRebind();
                return;
            }
            CancelRebind();
            _activeRebind = entry;
            entry.IsRebinding = true;

            // Start global key listening. KeyDown on the Window root is
            // the simplest path; PreviewKeyDown is unavailable in WinUI3.
            this.Content.KeyDown += OnRebindKeyDown;
            this.Content.Focus(FocusState.Programmatic);
        }

        private void CancelRebind()
        {
            if (_activeRebind is not null)
            {
                _activeRebind.IsRebinding = false;
                _activeRebind = null;
            }
            this.Content.KeyDown -= OnRebindKeyDown;
        }

        private void OnRebindKeyDown(object sender, KeyRoutedEventArgs e)
        {
            if (_activeRebind is null) return;

            // Esc cancels rebinding without saving.
            if (e.Key == VirtualKey.Escape)
            {
                e.Handled = true;
                CancelRebind();
                return;
            }

            // Ignore lone modifier presses — wait for a real key.
            if (e.Key is VirtualKey.Control or VirtualKey.Shift
                or VirtualKey.Menu or VirtualKey.LeftWindows or VirtualKey.RightWindows)
                return;

            // Compose the binding string from current modifier state.
            var window = (Microsoft.UI.Xaml.Window)this;
            var ctrl  = window.Content.XamlRoot is { } x && InputKeyboardSource.GetKeyStateForCurrentThread(VirtualKey.Control).HasFlag(Windows.UI.Core.CoreVirtualKeyStates.Down);
            var shift = InputKeyboardSource.GetKeyStateForCurrentThread(VirtualKey.Shift).HasFlag(Windows.UI.Core.CoreVirtualKeyStates.Down);
            var alt   = InputKeyboardSource.GetKeyStateForCurrentThread(VirtualKey.Menu).HasFlag(Windows.UI.Core.CoreVirtualKeyStates.Down);

            var parts = new System.Collections.Generic.List<string>();
            if (ctrl)  parts.Add("Ctrl");
            if (shift) parts.Add("Shift");
            if (alt)   parts.Add("Alt");
            parts.Add(KeyDisplayName(e.Key));

            _activeRebind.Binding = string.Join(" + ", parts);
            e.Handled = true;
            CancelRebind();

            // TODO: forward _activeRebind.Key + new binding to your
            // Hotkeys service so it re-registers the global hotkey.
        }

        private static string KeyDisplayName(VirtualKey k) => k switch
        {
            >= VirtualKey.A and <= VirtualKey.Z => k.ToString(),
            >= VirtualKey.Number0 and <= VirtualKey.Number9
                => ((int)k - (int)VirtualKey.Number0).ToString(),
            VirtualKey.Snapshot => "PrtSc",
            VirtualKey.Space    => "Space",
            VirtualKey.Tab      => "Tab",
            VirtualKey.Enter    => "Enter",
            >= VirtualKey.F1 and <= VirtualKey.F12 => k.ToString(),
            _ => k.ToString(),
        };
    }
}
