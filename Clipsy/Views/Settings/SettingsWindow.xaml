<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{StaticResource ClipsyBg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============== Custom titlebar ============== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{StaticResource ClipsyBg0Brush}"
              BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{StaticResource ClipsyAccentBrush}">
                    <FontIcon Glyph="&#xE722;" FontSize="11" Foreground="White" />
                </Border>
                <TextBlock Text="Clipsy" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource ClipsyTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="14"
                           Foreground="{StaticResource ClipsyText3Brush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarSubtitle" Text="Settings" FontSize="13"
                           Foreground="{StaticResource ClipsyText2Brush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnTitleMin" Style="{StaticResource ClipsyCaptionBtn}"
                        Click="OnTitleMinimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="BtnTitleMax" Style="{StaticResource ClipsyCaptionBtn}"
                        Click="OnTitleMaximize">
                    <FontIcon x:Name="BtnTitleMaxIcon" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button x:Name="BtnTitleClose" Style="{StaticResource ClipsyCaptionBtnClose}"
                        Click="OnTitleClose">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============== Body ============== -->
        <Grid Grid.Row="1" Background="{StaticResource ClipsyBg0Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============== Sidebar ============== -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Background="{StaticResource ClipsyBg0Brush}"
                    BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SETTINGS"
                               Style="{StaticResource ClipsyLabel}"
                               Margin="18,18,18,10" />

                    <ListView x:Name="NavList"
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnNavSelectionChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ItemContainerStyle="{StaticResource ClipsyNavItem}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">

                        <ListViewItem x:Name="NavGeneral" Tag="general" IsSelected="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavGeneral" Grid.Column="0"
                                          Glyph="&#xE713;" FontSize="16"
                                          />
                                <TextBlock x:Name="NavGeneralLabel" Grid.Column="1"
                                           Text="General" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <ListViewItem x:Name="NavVideo" Tag="video">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavVideo" Grid.Column="0"
                                          Glyph="&#xE714;" FontSize="16"
                                          />
                                <TextBlock x:Name="NavVideoLabel" Grid.Column="1"
                                           Text="Video" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <ListViewItem x:Name="NavGif" Tag="gif">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavGif" Grid.Column="0"
                                          Glyph="&#xE91B;" FontSize="16"
                                          />
                                <TextBlock x:Name="NavGifLabel" Grid.Column="1"
                                           Text="GIF" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <ListViewItem x:Name="NavHotkeys" Tag="hotkeys">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavHotkeys" Grid.Column="0"
                                          Glyph="&#xE765;" FontSize="16"
                                          />
                                <TextBlock x:Name="NavHotkeysLabel" Grid.Column="1"
                                           Text="Hotkeys" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <ListViewItem x:Name="NavInfo" Tag="info">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavInfo" Grid.Column="0"
                                          Glyph="&#xE946;" FontSize="16"
                                          />
                                <TextBlock x:Name="NavInfoLabel" Grid.Column="1"
                                           Text="Info" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                    </ListView>

                    <Border Grid.Row="2"
                            Background="{StaticResource ClipsyBg1Brush}"
                            BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="12,12,12,16"
                            Padding="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="TIP" Style="{StaticResource ClipsyLabel}" />
                            <TextBlock x:Name="LblTip"
                                       Text="Press PrtSc anywhere to capture."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============== Content ============== -->
            <Border Grid.Row="0" Grid.Column="1"
                    Background="{StaticResource ClipsyBg1Brush}">
                <ScrollViewer Padding="32,28,32,20"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>

                        <!-- ===== General ===== -->
                        <StackPanel x:Name="PaneGeneral" Spacing="16" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrGeneral" Text="General"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubGeneral"
                                           Text="Language, theme, and where files end up."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblLanguage" Text="Language"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperLanguage"
                                                       Text="Auto-detect uses the system locale."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LangBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="LangAuto" Content="Auto-detect" Tag="auto" />
                                            <ComboBoxItem x:Name="LangEn" Content="English" Tag="en" />
                                            <ComboBoxItem x:Name="LangRu" Content="Russian" Tag="ru" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTheme" Text="Theme"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperTheme"
                                                       Text="Live-switches without restart."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource ClipsyBgInputBrush}"
                                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="3"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="ThemeBtnAuto"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="auto" Click="OnThemeSegmentClick">
                                                    <TextBlock x:Name="ThemeBtnAutoLabel" Text="Auto" />
                                                </ToggleButton>
                                                <ToggleButton x:Name="ThemeBtnDark"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="dark" Click="OnThemeSegmentClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE708;" FontSize="13" />
                                                        <TextBlock x:Name="ThemeBtnDarkLabel" Text="Dark" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton x:Name="ThemeBtnLight"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="light" Click="OnThemeSegmentClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE706;" FontSize="13" />
                                                        <TextBlock x:Name="ThemeBtnLightLabel" Text="Light" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblOcrEngine" Text="OCR engine"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperOcr"
                                                       Text="Tesseract is bundled. Windows OCR is faster but lower-quality."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="OcrEngineBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="OcrTesseract" Content="Tesseract (default)" Tag="Tesseract" />
                                            <ComboBoxItem x:Name="OcrWinRt" Content="Windows OCR" Tag="WinRT" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="LblScreenshotFolder" Text="Screenshot folder"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ScreenshotFolderBox" Grid.Column="0" />
                                            <Button x:Name="ScreenshotFolderPick" Grid.Column="1"
                                                    Style="{StaticResource ClipsyButtonGhost}"
                                                    Content="Browse"
                                                    Click="OnScreenshotFolderPick" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="LblVideoFolder" Text="Video folder"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VideoFolderBox" Grid.Column="0" />
                                            <Button x:Name="VideoFolderPick" Grid.Column="1"
                                                    Style="{StaticResource ClipsyButtonGhost}"
                                                    Content="Browse"
                                                    Click="OnVideoFolderPick" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Remember last Save As folder"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperRemember"
                                                       Text="Future captures default to wherever you saved last."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RememberFolderSwitch" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="LblScreenshotFormat" Text="Screenshot format"
                                                   Style="{StaticResource ClipsyBodyStrong}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="ScreenshotFormatBox" Grid.Column="1" MinWidth="260"
                                                  SelectionChanged="OnScreenshotFormatChanged"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="FmtPng" Content="PNG (lossless)" Tag="png" />
                                            <ComboBoxItem x:Name="FmtJpg" Content="JPEG (smaller)" Tag="jpg" />
                                            <ComboBoxItem x:Name="FmtWebp" Content="WebP (preview, falls back to PNG)" Tag="webp" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid x:Name="JpgQualityRow" ColumnSpacing="10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock x:Name="LblJpgQuality" Text="JPEG quality"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <Slider x:Name="JpgQualitySlider" StepFrequency="1"
                                                    Minimum="1" Maximum="100" Value="85"
                                                    ValueChanged="OnJpgQualityChanged"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="JpgQualityLabel" Grid.Column="1"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                   Style="{StaticResource ClipsyMono}" />
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="LblAfterSave" Text="After save"
                                                   Style="{StaticResource ClipsyBodyStrong}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="AfterSaveBox" Grid.Column="1" MinWidth="220"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="AfterNothing" Content="Do nothing" Tag="nothing" />
                                            <ComboBoxItem x:Name="AfterOpenFile" Content="Open file" Tag="open-file" />
                                            <ComboBoxItem x:Name="AfterOpenFolder" Content="Open folder" Tag="open-folder" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblUpdates" Text="Updates"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperUpdates"
                                                   Text="Last checked 2 hours ago."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="UpdateIntervalBox" MinWidth="200">
                                            <ComboBoxItem x:Name="UpdHourly" Content="Hourly" Tag="hourly" />
                                            <ComboBoxItem x:Name="UpdDaily" Content="Daily" Tag="daily" />
                                            <ComboBoxItem x:Name="UpdWeekly" Content="Weekly" Tag="weekly" />
                                            <ComboBoxItem x:Name="UpdMonthly" Content="Monthly" Tag="monthly" />
                                            <ComboBoxItem x:Name="UpdNever" Content="Never" Tag="never" />
                                        </ComboBox>
                                        <Button x:Name="BtnCheckNow"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Click="OnCheckUpdates">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="Check now" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Video ===== -->
                        <StackPanel x:Name="PaneVideo" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrVideo" Text="Video"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubVideo"
                                           Text="Codec, resolution, and bitrate for screen recordings."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblCodec" Text="Codec"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperCodec"
                                                   Text="Default H.264 hardware encode at 30 fps."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <RadioButton x:Name="RadioCodecH264" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="H.264">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="H.264" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Wide compatibility, hardware-accelerated"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ClipsyText3Brush}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecH265" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="H.265">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="H.265" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Smaller files, slower encode"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ClipsyText3Brush}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecVp9" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="VP9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="VP9" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Web-friendly, open codec"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ClipsyText3Brush}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecAv1" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="AV1">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="AV1" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Smallest, very slow encoder"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ClipsyText3Brush}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblResolution" Text="Resolution"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="LblRegionNote"
                                                       Text="Applies to full-screen only. Region recordings use their selection size."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource ClipsyBgInputBrush}"
                                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="3"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="ResBtn480p" Content="480p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="480p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn720p" Content="720p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="720p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn1080p" Content="1080p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="1080p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn1440p" Content="1440p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="1440p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtnOriginal" Content="Original"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="Original" Click="OnResolutionSegmentClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblBitrate" Text="Bitrate"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperBitrate"
                                                       Text="Higher bitrate = better quality and larger files. Max scales with resolution."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BitrateSlider" Grid.Column="0" StepFrequency="1"
                                                    Minimum="1" Maximum="50" Value="8"
                                                    ValueChanged="OnBitrateChanged" />
                                            <TextBlock x:Name="BitrateLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Background="{StaticResource ClipsyBg2Brush}"
                                            BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{StaticResource ClipsyText3Brush}" />
                                            <TextBlock x:Name="EstFileSizeLabel"
                                                       Style="{StaticResource ClipsyHelper}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== GIF ===== -->
                        <StackPanel x:Name="PaneGif" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrGif" Text="GIF"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubGif"
                                           Text="Output settings when exporting recordings as animated GIF."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblGifColors" Text="Color count"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifColors"
                                                       Text="Fewer colors = smaller file but more banding."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="GifColorSlider" Grid.Column="0" StepFrequency="16"
                                                    Minimum="16" Maximum="256" Value="128"
                                                    ValueChanged="OnGifColorChanged" />
                                            <TextBlock x:Name="GifColorLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblGifFps" Text="Frame rate"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifFps"
                                                       Text="12 fps is a good default for screen content."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="GifFpsSlider" Grid.Column="0" StepFrequency="1"
                                                    Minimum="1" Maximum="30" Value="12"
                                                    ValueChanged="OnGifFpsChanged" />
                                            <TextBlock x:Name="GifFpsLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblGifDither" Text="Dithering" Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifDither"
                                                       Text="Smooths color transitions at the cost of file size."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="GifDitherSwitch" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Hotkeys ===== -->
                        <StackPanel x:Name="PaneHotkeys" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrHotkeys" Text="Hotkeys"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="LblHotkeyHint"
                                           Text="Click a binding, then press the key or combo. Esc cancels rebinding."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Background="{StaticResource ClipsyBg2Brush}"
                                    BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="{StaticResource ClipsyBg1Brush}"
                                            BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,8"
                                            CornerRadius="8,8,0,0">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ACTION" Style="{StaticResource ClipsyLabel}" />
                                            <TextBlock Grid.Column="1" Text="BINDING" Style="{StaticResource ClipsyLabel}"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <ListView x:Name="HotkeyList"
                                              Grid.Row="1"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0,6">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="44" />
                                                <Setter Property="Margin" Value="0,4,0,4" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,4" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ClipsyTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource ClipsyKeyChip}"
                                                            Click="OnHotkeyRebindClick"
                                                            Tag="{Binding Key}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Binding}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== Info ===== -->
                        <StackPanel x:Name="PaneInfo" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="14"
                                        Background="{StaticResource ClipsyAccentBrush}">
                                    <FontIcon Glyph="&#xE722;" FontSize="28" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Clipsy" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{StaticResource ClipsyTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{StaticResource ClipsyBg2Brush}"
                                                BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,3">
                                            <TextBlock x:Name="VersionLabel"
                                                       Style="{StaticResource ClipsyMono}"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock x:Name="BuildDateLabel"
                                                   Style="{StaticResource ClipsyHelper}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="LblAuthor" Text="Author"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="LblAuthorName" Text="Sidiusz"
                                                       Style="{StaticResource ClipsyHelper}" />
                                            <TextBlock Text="·" Style="{StaticResource ClipsyHelper}" />
                                            <TextBlock Text="MIT" Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="github.com/Sidiusz/Clipsy"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock Text="Source, issues, releases"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1"
                                                         Content="Open"
                                                         NavigateUri="https://github.com/Sidiusz/Clipsy"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Updates" Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="UpdateStatusLabel"
                                                       Text="You are on the latest version."
                                                       Foreground="{StaticResource ClipsySuccessBrush}"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Button x:Name="BtnCheckForUpdates" Grid.Column="1"
                                                Click="OnCheckUpdates" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="Check now" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Like Clipsy?" Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock Text="Star it on GitHub — that's enough." Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1"
                                                     NavigateUri="https://github.com/Sidiusz/Clipsy"
                                                     VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE735;" FontSize="13" />
                                            <TextBlock Text="Star" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ============== Footer ============== -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{StaticResource ClipsyBg0Brush}"
                    BorderBrush="{StaticResource ClipsyBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BtnReset" Style="{StaticResource ClipsyButtonGhost}"
                            Content="Reset" Click="OnReset" />
                    <Button x:Name="BtnClose" Content="Close" Click="OnClose" />
                    <Button x:Name="BtnSave" Style="{StaticResource ClipsyButtonPrimary}"
                            Content="Save changes" Click="OnSave" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
