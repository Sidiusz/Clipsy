<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView x:Name="Tabs"
                 Grid.Row="0"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 TabWidthMode="SizeToContent">

            <TabViewItem x:Name="TabGeneral" Header="General" IsClosable="False">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="LblLanguage" Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="LangBox" Width="240">
                            <ComboBoxItem x:Name="LangAuto" Content="Auto-detect" Tag="auto" />
                            <ComboBoxItem x:Name="LangEn" Content="English" Tag="en" />
                            <ComboBoxItem x:Name="LangRu" Content="Russian" Tag="ru" />
                        </ComboBox>

                        <TextBlock x:Name="LblTheme" Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="ThemeBox" Width="240">
                            <ComboBoxItem x:Name="ThemeAuto" Content="Auto-detect" Tag="auto" />
                            <ComboBoxItem x:Name="ThemeDark" Content="Dark" Tag="dark" />
                            <ComboBoxItem x:Name="ThemeLight" Content="Light" Tag="light" />
                        </ComboBox>

                        <TextBlock x:Name="LblOcrEngine" Text="OCR engine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="OcrEngineBox" Width="240">
                            <ComboBoxItem x:Name="OcrTesseract" Content="Tesseract (default)" Tag="Tesseract" />
                            <ComboBoxItem x:Name="OcrWinRt" Content="Windows OCR" Tag="WinRT" />
                        </ComboBox>

                        <TextBlock x:Name="LblScreenshotFolder" Text="Screenshot folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ScreenshotFolderBox" Grid.Column="0" />
                            <Button x:Name="ScreenshotFolderPick" Grid.Column="1" Content="Browse" Click="OnScreenshotFolderPick" />
                        </Grid>

                        <TextBlock x:Name="LblVideoFolder" Text="Video folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VideoFolderBox" Grid.Column="0" />
                            <Button x:Name="VideoFolderPick" Grid.Column="1" Content="Browse" Click="OnVideoFolderPick" />
                        </Grid>

                        <ToggleSwitch x:Name="RememberFolderSwitch" Header="Remember last Save As folder" />

                        <TextBlock x:Name="LblScreenshotFormat" Text="Screenshot format" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="ScreenshotFormatBox" Width="240" SelectionChanged="OnScreenshotFormatChanged">
                            <ComboBoxItem x:Name="FmtPng" Content="PNG (lossless)" Tag="png" />
                            <ComboBoxItem x:Name="FmtJpg" Content="JPEG (smaller)" Tag="jpg" />
                            <ComboBoxItem x:Name="FmtWebp" Content="WebP (preview, falls back to PNG)" Tag="webp" />
                        </ComboBox>

                        <Grid x:Name="JpgQualityRow" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="LblJpgQuality" Text="JPEG quality" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Slider x:Name="JpgQualitySlider" Minimum="50" Maximum="100" StepFrequency="1" ValueChanged="OnJpgQualityChanged" />
                            </StackPanel>
                            <TextBlock x:Name="JpgQualityLabel" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </Grid>

                        <TextBlock x:Name="LblAfterSave" Text="After save" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="AfterSaveBox" Width="240">
                            <ComboBoxItem x:Name="AfterNothing" Content="Do nothing" Tag="nothing" />
                            <ComboBoxItem x:Name="AfterOpenFile" Content="Open file" Tag="open-file" />
                            <ComboBoxItem x:Name="AfterOpenFolder" Content="Open folder" Tag="open-folder" />
                        </ComboBox>

                        <TextBlock x:Name="LblUpdates" Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="UpdateIntervalBox" Grid.Column="0">
                                <ComboBoxItem x:Name="UpdHourly" Content="Hourly" Tag="hourly" />
                                <ComboBoxItem x:Name="UpdDaily" Content="Daily" Tag="daily" />
                                <ComboBoxItem x:Name="UpdWeekly" Content="Weekly" Tag="weekly" />
                                <ComboBoxItem x:Name="UpdMonthly" Content="Monthly" Tag="monthly" />
                                <ComboBoxItem x:Name="UpdNever" Content="Never" Tag="never" />
                            </ComboBox>
                            <Button x:Name="BtnCheckNow" Grid.Column="1" Content="Check now" Click="OnCheckUpdates" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="TabVideo" Header="Video" IsClosable="False">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="LblCodec" Text="Codec" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="CodecBox" Width="240" SelectionChanged="OnCodecChanged">
                            <ComboBoxItem x:Name="CodecH264Item" Content="H.264, wide compatibility" Tag="H.264" />
                            <ComboBoxItem x:Name="CodecH265Item" Content="H.265, smaller files" Tag="H.265" />
                            <ComboBoxItem x:Name="CodecVp9Item"  Content="VP9, web-friendly"  Tag="VP9" />
                            <ComboBoxItem x:Name="CodecAv1Item"  Content="AV1, smallest, slow encoder" Tag="AV1" />
                        </ComboBox>

                        <TextBlock x:Name="LblResolution" Text="Resolution (full screen only)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="ResolutionBox" Width="240" SelectionChanged="OnResolutionChanged">
                            <ComboBoxItem Content="480p" Tag="480p" />
                            <ComboBoxItem Content="720p" Tag="720p" />
                            <ComboBoxItem Content="1080p" Tag="1080p" />
                            <ComboBoxItem Content="1440p" Tag="1440p" />
                            <ComboBoxItem Content="Original" Tag="Original" />
                        </ComboBox>
                        <TextBlock x:Name="LblRegionNote" Text="Region recordings use the selection size directly." FontSize="12" Foreground="#FFAAAAAA" />

                        <TextBlock x:Name="LblBitrate" Text="Bitrate (Mbps)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BitrateSlider" Grid.Column="0" Minimum="1" Maximum="16" StepFrequency="1" SmallChange="1" ValueChanged="OnBitrateChanged" />
                            <TextBlock x:Name="BitrateLabel" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="EstFileSizeLabel" Foreground="#FFAAAAAA" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="TabGif" Header="GIF" IsClosable="False">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="LblGifColors" Text="Color count" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="GifColorSlider" Grid.Column="0" Minimum="16" Maximum="256" StepFrequency="16" ValueChanged="OnGifColorChanged" />
                            <TextBlock x:Name="GifColorLabel" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="LblGifFps" Text="Frame rate (fps)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="GifFpsSlider" Grid.Column="0" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnGifFpsChanged" />
                            <TextBlock x:Name="GifFpsLabel" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <ToggleSwitch x:Name="GifDitherSwitch" Header="Dithering" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="TabHotkeys" Header="Hotkeys" IsClosable="False">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="LblHotkeyHint" Text="Click a binding to rebind. Esc is reserved." FontSize="12" Foreground="#FFAAAAAA" />
                        <ListView x:Name="HotkeyList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding Binding}" Click="OnHotkeyRebindClick" Tag="{Binding Key}" MinWidth="140" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="TabInfo" Header="Info" IsClosable="False">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Clipsy" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionLabel" Foreground="#FFAAAAAA" />
                        <TextBlock x:Name="LblAuthor" Text="Author: Sidiusz" />
                        <HyperlinkButton Content="github.com/Sidiusz/Clipsy" NavigateUri="https://github.com/Sidiusz/Clipsy" />
                        <Button x:Name="BtnCheckForUpdates" Content="Check for updates" Click="OnCheckUpdates" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="1"
                BorderBrush="#FF2E2E2E"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Content="Reset" Click="OnReset" />
                <Button x:Name="BtnClose" Content="Close" Click="OnClose" />
                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
