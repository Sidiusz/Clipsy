<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clipsy.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ClipsyBg0Brush}">
        <!-- Round all input fields in Settings. Scoped here so overlay/HUD
             inputs keep their own look. BasedOn the keyed Clipsy styles which
             carry the input surface + border; FontFamily kept for Onest. -->
        <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource ClipsyTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
                <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusMd}" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ClipsyComboBox}">
                <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
                <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusMd}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============== Custom titlebar (drag region for system caption) ============== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{ThemeResource ClipsyBg0Brush}"
              BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="8" Margin="12,0" VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <Image Width="20" Height="20"
                       Source="ms-appx:///Assets/Icons/clipsy-32.png" />
                <TextBlock Text="Clipsy" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}"
                           Foreground="{ThemeResource ClipsyTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="14"
                           Foreground="{ThemeResource ClipsyText3Brush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarSubtitle" Text="Settings" FontSize="13"
                           Foreground="{ThemeResource ClipsyText2Brush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============== Body ============== -->
        <Grid Grid.Row="1" Background="{ThemeResource ClipsyBg0Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============== Sidebar ============== -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Background="{ThemeResource ClipsyBg0Brush}"
                    BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               x:Name="LblSettingsHeader"
                               Text="SETTINGS"
                               Style="{StaticResource ClipsyLabel}"
                               Margin="18,18,18,10" />

                    <StackPanel x:Name="NavList" Grid.Row="1" Spacing="0" Padding="0,4">

                        <RadioButton x:Name="NavGeneral" Tag="general"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     IsChecked="True"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavGeneral" Grid.Column="0"
                                          Glyph="&#xE713;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavGeneralLabel" Grid.Column="1"
                                           Text="General" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavVideo" Tag="video"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavVideo" Grid.Column="0"
                                          Glyph="&#xE714;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavVideoLabel" Grid.Column="1"
                                           Text="Video" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavGif" Tag="gif"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavGif" Grid.Column="0"
                                          Glyph="&#xE91B;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavGifLabel" Grid.Column="1"
                                           Text="GIF" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavHotkeys" Tag="hotkeys"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavHotkeys" Grid.Column="0"
                                          Glyph="&#xE765;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavHotkeysLabel" Grid.Column="1"
                                           Text="Hotkeys" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavOcr" Tag="ocr"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavOcr" Grid.Column="0"
                                          Glyph="&#xE775;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavOcrLabel" Grid.Column="1"
                                           Text="OCR" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavNotifications" Tag="notifications"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavNotifications" Grid.Column="0"
                                          Glyph="&#xEA8F;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavNotificationsLabel" Grid.Column="1"
                                           Text="Notifications" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavInfo" Tag="info"
                                     Style="{StaticResource ClipsyNavRadio}"
                                     GroupName="ClipsyNav"
                                     Checked="OnNavChecked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconNavInfo" Grid.Column="0"
                                          Glyph="&#xE946;" FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="NavInfoLabel" Grid.Column="1"
                                           Text="Info" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{ThemeResource ClipsyBg1Brush}"
                            BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="12,12,12,16"
                            Padding="10">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="LblTipHeader" Text="TIP" Style="{StaticResource ClipsyLabel}" />
                            <TextBlock x:Name="LblTip"
                                       Text="Press PrtSc anywhere to capture."
                                       Style="{StaticResource ClipsyHelper}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============== Content ============== -->
            <Border Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource ClipsyBg1Brush}">
                <ScrollViewer Padding="32,28,32,20"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>

                        <!-- ===== General ===== -->
                        <StackPanel x:Name="PaneGeneral" Spacing="16" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrGeneral" Text="General"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubGeneral"
                                           Text="Language, theme, and where files end up."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource ClipsyText2Brush}" />
                                                <TextBlock x:Name="LblLanguage" Text="Language"
                                                           Style="{StaticResource ClipsyBodyStrong}" />
                                            </StackPanel>
                                            <TextBlock x:Name="HelperLanguage"
                                                       Text="Auto-detect follows the system language."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LangBox" Grid.Column="1" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged">
                                            <ComboBoxItem x:Name="LangAuto" Content="Auto-detect" Tag="auto" />
                                            <ComboBoxItem x:Name="LangEn" Content="English" Tag="en" />
                                            <ComboBoxItem x:Name="LangRu" Content="Russian" Tag="ru" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTheme" Text="Theme"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperTheme"
                                                       Text="Applies instantly, no restart needed."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource ClipsyBgInputBrush}"
                                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="3"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="ThemeBtnAuto"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="auto" Click="OnThemeSegmentClick">
                                                    <TextBlock x:Name="ThemeBtnAutoLabel" Text="Auto" />
                                                </ToggleButton>
                                                <ToggleButton x:Name="ThemeBtnDark"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="dark" Click="OnThemeSegmentClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE708;" FontSize="13" />
                                                        <TextBlock x:Name="ThemeBtnDarkLabel" Text="Dark" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton x:Name="ThemeBtnLight"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="light" Click="OnThemeSegmentClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE706;" FontSize="13" />
                                                        <TextBlock x:Name="ThemeBtnLightLabel" Text="Light" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="LblScreenshotFolder" Text="Screenshot folder"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ScreenshotFolderBox" Grid.Column="0" TextChanged="OnAnyTextChanged" />
                                            <Button x:Name="ScreenshotFolderPick" Grid.Column="1"
                                                    Style="{StaticResource ClipsyButtonGhost}"
                                                    Content="Browse"
                                                    Click="OnScreenshotFolderPick" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="LblVideoFolder" Text="Video folder"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VideoFolderBox" Grid.Column="0" TextChanged="OnAnyTextChanged" />
                                            <Button x:Name="VideoFolderPick" Grid.Column="1"
                                                    Style="{StaticResource ClipsyButtonGhost}"
                                                    Content="Browse"
                                                    Click="OnVideoFolderPick" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblRememberFolder"
                                                       Text="Remember last Save As folder"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperRemember"
                                                       Text="New captures go to the folder you saved in last. Default: on."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="RememberFolderSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAnyToggleChanged"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="LblScreenshotFormat" Text="Screenshot format"
                                                   Style="{StaticResource ClipsyBodyStrong}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="ScreenshotFormatBox" Grid.Column="1" Width="260" HorizontalAlignment="Right"
                                                  SelectionChanged="OnScreenshotFormatChanged"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="FmtPng" Content="PNG (lossless)" Tag="png" />
                                            <ComboBoxItem x:Name="FmtJpg" Content="JPEG (smaller)" Tag="jpg" />
                                            <ComboBoxItem x:Name="FmtWebp" Content="WebP (preview, falls back to PNG)" Tag="webp" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid x:Name="JpgQualityRow" ColumnSpacing="10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock x:Name="LblJpgQuality" Text="JPEG quality"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <Slider x:Name="JpgQualitySlider" StepFrequency="1"
                                                    Minimum="1" Maximum="100" Value="85"
                                                    ValueChanged="OnJpgQualityChanged"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="JpgQualityLabel" Grid.Column="1"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                   Style="{StaticResource ClipsyMono}" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblScreenshotCursor" Text="Include cursor"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperScreenshotCursor"
                                                       Text="Show the mouse pointer in screenshots. Default: off."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="ScreenshotCursorSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAnyToggleChanged"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblDynamicIslands" Text="Dynamic tool islands"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperDynamicIslands"
                                                       Text="Toolbars dock to the corner where the selection drag ends."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="DynamicIslandsSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAnyToggleChanged"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAfterSave" Text="After-save behavior"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperAfterSave"
                                                       Text="What Clipsy does right after a screenshot or recording is saved."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="AfterSaveBox" Grid.Column="1" Width="240" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged">
                                            <ComboBoxItem x:Name="AfterNothing" Content="Do nothing" Tag="nothing" />
                                            <ComboBoxItem x:Name="AfterOpenFile" Content="Open file" Tag="open-file" />
                                            <ComboBoxItem x:Name="AfterOpenFolder" Content="Open folder" Tag="open-folder" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblEyedropperMod" Text="Eyedropper modifier"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperEyedropperMod"
                                                       Text="Hold this key while a draw tool is active to pick a color."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="EyedropperModBox" Grid.Column="1" Width="240" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged">
                                            <ComboBoxItem x:Name="EyedropperModAlt" Content="Alt" Tag="Alt" />
                                            <ComboBoxItem x:Name="EyedropperModCtrl" Content="Ctrl" Tag="Ctrl" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="LblAppManagement" Text="App management"
                                               Style="{StaticResource ClipsyBodyStrong}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAutostart"
                                                       Text="Start with Windows"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperAutostart"
                                                       Text="Launch Clipsy when you sign in."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="AutostartSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAutostartToggled"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblUpdates" Text="Updates"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperUpdates"
                                                       Text="How often Clipsy checks for a new version."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <ComboBox x:Name="UpdateIntervalBox" Width="160"
                                                      SelectionChanged="OnAnyControlChanged">
                                                <ComboBoxItem x:Name="UpdHourly" Content="Hourly" Tag="hourly" />
                                                <ComboBoxItem x:Name="UpdDaily" Content="Daily" Tag="daily" />
                                                <ComboBoxItem x:Name="UpdWeekly" Content="Weekly" Tag="weekly" />
                                                <ComboBoxItem x:Name="UpdMonthly" Content="Monthly" Tag="monthly" />
                                                <ComboBoxItem x:Name="UpdNever" Content="Never" Tag="never" />
                                            </ComboBox>
                                            <Button x:Name="BtnCheckNow"
                                                    Style="{StaticResource ClipsyButtonGhost}"
                                                    Click="OnCheckUpdates">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                    <TextBlock Text="Check now" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ===== Video ===== -->
                        <StackPanel x:Name="PaneVideo" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrVideo" Text="Video"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubVideo"
                                           Text="Codec, resolution, and bitrate for screen recordings."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LblCodec" Text="Codec"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="HelperCodec"
                                                   Text="How the video is compressed. Affects file size, encoding speed and compatibility."
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <RadioButton x:Name="RadioCodecH264" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="H.264" Checked="OnAnyControlChanged">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="H.264" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}" />
                                                <TextBlock x:Name="LblCodecH264Desc" Text="Wide compatibility, hardware-accelerated"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecH265" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="H.265" Checked="OnAnyControlChanged">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="H.265" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}" />
                                                <TextBlock x:Name="LblCodecH265Desc" Text="Smaller files, slower encode"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecVp9" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="VP9" Checked="OnAnyControlChanged">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="VP9" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}" />
                                                <TextBlock x:Name="LblCodecVp9Desc" Text="Web-friendly, open codec"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RadioCodecAv1" Style="{StaticResource ClipsyRadioCard}"
                                                     GroupName="Codec" Tag="AV1" Checked="OnAnyControlChanged">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="AV1" FontSize="13" FontWeight="{StaticResource ClipsyFontWeightStrong}" />
                                                <TextBlock x:Name="LblCodecAv1Desc" Text="Smallest, very slow encoder"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <!-- FFmpeg section -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblFfmpegSection" Text="FFmpeg"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperCodecVp9Av1"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border x:Name="FfmpegStatusBadge" Grid.Column="1"
                                                BorderThickness="1" CornerRadius="12" Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="FfmpegStatusText"
                                                       FontSize="11" FontWeight="{StaticResource ClipsyFontWeightStrong}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel x:Name="FfmpegProgressRow" Spacing="4" Visibility="Collapsed">
                                        <ProgressBar x:Name="FfmpegProgressBar"
                                                     Minimum="0" Maximum="100" Value="0" />
                                        <TextBlock x:Name="FfmpegProgressText"
                                                   Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BtnInstallFfmpeg"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Click="OnFfmpegInstall" />
                                        <Button x:Name="BtnDeleteFfmpeg"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Click="OnFfmpegDelete"
                                                Visibility="Collapsed" />
                                        <Button x:Name="BtnCancelFfmpeg"
                                                Style="{StaticResource ClipsyButtonGhost}"
                                                Click="OnFfmpegCancel"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Microphone card -->
                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblMicEnabled" Text="Record microphone"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperMic"
                                                       Text="Record the microphone along with the screen. Default: off."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="MicEnabledSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnMicEnabledToggled"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel x:Name="MicDevicePanel" Spacing="16" Visibility="Collapsed">
                                        <Border Style="{StaticResource ClipsyHairline}" />
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="LblMicDevice" Text="Input device"
                                                           Style="{StaticResource ClipsyBodyStrong}" />
                                                <TextBlock x:Name="HelperMicDevice"
                                                           Text="Leave on default to use the system microphone."
                                                           Style="{StaticResource ClipsyHelper}" />
                                            </StackPanel>
                                            <ComboBox x:Name="MicDeviceBox" Grid.Column="1" Width="240"
                                                      SelectionChanged="OnMicDeviceChanged"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblResolution" Text="Resolution"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="LblRegionNote"
                                                       Text="Maximum video height: larger recordings are scaled down to it, smaller ones keep their size. Default: 1080p"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource ClipsyBgInputBrush}"
                                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="3"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="ResBtn480p" Content="480p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="480p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn720p" Content="720p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="720p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn1080p" Content="1080p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="1080p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtn1440p" Content="1440p"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="1440p" Click="OnResolutionSegmentClick" />
                                                <ToggleButton x:Name="ResBtnOriginal" Content="Original"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="Original" Click="OnResolutionSegmentClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblVideoFps" Text="Frame rate"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperVideoFps"
                                                       Text="How many frames per second are recorded. Native follows the display refresh rate. Default: 60"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource ClipsyBgInputBrush}"
                                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="3"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="FpsBtn15" Content="15"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="15" Click="OnFpsSegmentClick" />
                                                <ToggleButton x:Name="FpsBtn30" Content="30"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="30" Click="OnFpsSegmentClick" />
                                                <ToggleButton x:Name="FpsBtn60" Content="60"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="60" Click="OnFpsSegmentClick" />
                                                <ToggleButton x:Name="FpsBtnNative" Content="Native"
                                                              Style="{StaticResource ClipsySegmentBtn}"
                                                              Tag="0" Click="OnFpsSegmentClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblVideoFormat" Text="Video format"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperVideoFormat"
                                                       Text="Format used for automatic saves. Save As lets you pick a different one."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="VideoFormatBox" Grid.Column="1" Width="240" HorizontalAlignment="Right"
                                                  SelectionChanged="OnVideoFormatChanged"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="VidFmtMp4" Content="MP4 (recommended)" Tag="mp4" />
                                            <ComboBoxItem x:Name="VidFmtAvi" Content="AVI" Tag="avi" />
                                            <ComboBoxItem x:Name="VidFmtMkv" Content="MKV" Tag="mkv" />
                                            <ComboBoxItem x:Name="VidFmtGif" Content="GIF (animated)" Tag="gif" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblVideoCursor" Text="Include cursor"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperVideoCursor"
                                                       Text="Show the mouse pointer in recordings. Default: on."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="VideoCursorSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAnyToggleChanged"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblBitrate" Text="Bitrate"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperBitrate"
                                                       Text="Amount of data per second of video: more means sharper picture and bigger file. The cap depends on resolution. Default: 8 Mbps"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BitrateSlider" Grid.Column="0" StepFrequency="1"
                                                    Minimum="1" Maximum="50" Value="8"
                                                    ValueChanged="OnBitrateChanged" />
                                            <TextBlock x:Name="BitrateLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Background="{ThemeResource ClipsyBg2Brush}"
                                            BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource ClipsyText3Brush}" />
                                            <TextBlock x:Name="EstFileSizeLabel"
                                                       Style="{StaticResource ClipsyHelper}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== GIF ===== -->
                        <StackPanel x:Name="PaneGif" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrGif" Text="GIF"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubGif"
                                           Text="Output settings when exporting recordings as animated GIF."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblGifColors" Text="Color count"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifColors"
                                                       Text="Palette size of the GIF: fewer colors mean a smaller file. Default: 256"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="GifColorSlider" Grid.Column="0" StepFrequency="16"
                                                    Minimum="16" Maximum="256" Value="128"
                                                    ValueChanged="OnGifColorChanged" />
                                            <TextBlock x:Name="GifColorLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LblGifFps" Text="Frame rate"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifFps"
                                                       Text="How many frames per second the GIF contains. Default: 12"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="GifFpsSlider" Grid.Column="0" StepFrequency="1"
                                                    Minimum="1" Maximum="30" Value="12"
                                                    ValueChanged="OnGifFpsChanged" />
                                            <TextBlock x:Name="GifFpsLabel" Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource ClipsyMono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblGifDither" Text="Dithering" Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperGifDither"
                                                       Text="Blends palette colors to hide banding; the file gets a bit larger. Default: on."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="GifDitherSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnAnyToggleChanged"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== OCR ===== -->
                        <StackPanel x:Name="PaneOcr" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrOcr" Text="Text Recognition"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubOcr"
                                           Text="OCR engine and translation settings."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <!-- OCR engine card -->
                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblOcrEngine" Text="OCR engine"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperOcr"
                                                       Text="Engine that recognizes text in captures."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="OcrEngineBox" Grid.Column="1" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  SelectionChanged="OnOcrEngineChanged">
                                            <ComboBoxItem x:Name="OcrTesseract" Content="Tesseract" Tag="Tesseract" />
                                            <ComboBoxItem x:Name="OcrWinRt" Content="Windows OCR" Tag="WinRT" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Tesseract language management -->
                                    <Border x:Name="TessLangSection" Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <Border Style="{StaticResource ClipsyHairline}" />
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="LblTessLang" Text="Tesseract language packs"
                                                           Style="{StaticResource ClipsyBodyStrong}" />
                                                <TextBlock x:Name="HelperTessLang"
                                                           Text="Languages Tesseract can recognize offline (~4–22 MB each)."
                                                           Style="{StaticResource ClipsyHelper}" />
                                            </StackPanel>
                                            <StackPanel x:Name="TessLangList" Spacing="2" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Translation card -->
                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTranslateService" Text="Translation service"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperTranslation"
                                                       Text="Service and language pair used when translating recognized text."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="TranslateServiceBox" Grid.Column="1" Width="240"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged">
                                            <ComboBoxItem x:Name="TrSvcMyMemory" Content="MyMemory (free)" Tag="MyMemory" />
                                            <ComboBoxItem x:Name="TrSvcGoogle" Content="Google Translate" Tag="Google" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTranslateFrom" Text="Translate from"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperTranslateFrom"
                                                       Text="Source language of the recognized text."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="TranslateFromBox" Grid.Column="1" Width="240"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTranslateTo" Text="Translate to"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="HelperTranslateTo"
                                                       Text="Language the text is translated into."
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <ComboBox x:Name="TranslateToBox" Grid.Column="1" Width="240"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnAnyControlChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Hotkeys ===== -->
                        <StackPanel x:Name="PaneHotkeys" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrHotkeys" Text="Hotkeys"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="LblHotkeyHint"
                                           Text="Click a binding, then press the key or combo. Esc cancels rebinding."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Background="{ThemeResource ClipsyBg2Brush}"
                                    BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="{ThemeResource ClipsyBg1Brush}"
                                            BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,8"
                                            CornerRadius="8,8,0,0">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblColAction" Grid.Column="0" Text="ACTION" Style="{StaticResource ClipsyLabel}" />
                                            <TextBlock x:Name="LblColBinding" Grid.Column="1" Text="BINDING" Style="{StaticResource ClipsyLabel}"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <ListView x:Name="HotkeyList"
                                              Grid.Row="1"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0,6">
                                        <!-- Empty collection disables the default bottom-up
                                             entrance/reorder animation when rows populate. -->
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection />
                                        </ListView.ItemContainerTransitions>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="44" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Padding="14,6" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   FontSize="13"
                                                                   FontWeight="{StaticResource ClipsyFontWeightStrong}"
                                                                   Foreground="{ThemeResource ClipsyTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource ClipsyKeyChip}"
                                                                Click="OnHotkeyRebindClick"
                                                                Tag="{Binding Key}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Binding}" />
                                                        </Button>
                                                    </Grid>
                                                    <Border Grid.Row="1" Height="1"
                                                            Background="{ThemeResource ClipsyBorderSubtleBrush}"
                                                            Margin="14,0,14,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== Notifications ===== -->
                        <StackPanel x:Name="PaneNotifications" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HdrNotifications" Text="Notifications"
                                           Style="{StaticResource ClipsySectionTitle}" />
                                <TextBlock x:Name="SubNotifications"
                                           Text="Choose which events show a toast."
                                           Style="{StaticResource ClipsyHelper}" />
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="LblNotifyMaster"
                                                   Text="Show notifications"
                                                   Style="{StaticResource ClipsyBodyStrong}"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton x:Name="NotifyMasterSwitch" Grid.Column="1"
                                                      Style="{StaticResource ClipsyMiniToggle}"
                                                      Click="OnNotifyMasterToggled"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <StackPanel x:Name="NotifySubPanel" Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyScreenshot"
                                                       Text="Screenshot saved"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyScreenshotSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyVideo"
                                                       Text="Recording saved"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyVideoSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyClipboard"
                                                       Text="Copied to clipboard"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyClipboardSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyErrors"
                                                       Text="Errors"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyErrorsSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyUpdate"
                                                       Text="Update available"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyUpdateSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LblNotifyHints"
                                                       Text="Hints and info"
                                                       Style="{StaticResource ClipsyBodyStrong}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton x:Name="NotifyHintsSwitch" Grid.Column="1"
                                                          Style="{StaticResource ClipsyMiniToggle}"
                                                          Click="OnAnyToggleChanged"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Info ===== -->
                        <StackPanel x:Name="PaneInfo" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="14"
                                        Background="{ThemeResource ClipsyAccentBrush}">
                                    <FontIcon Glyph="&#xE722;" FontSize="28" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Clipsy" FontSize="26" FontWeight="{StaticResource ClipsyFontWeightTitle}"
                                               Foreground="{ThemeResource ClipsyTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource ClipsyBg2Brush}"
                                                BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,3">
                                            <TextBlock x:Name="VersionLabel"
                                                       Style="{StaticResource ClipsyMono}"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock x:Name="BuildDateLabel"
                                                   Style="{StaticResource ClipsyHelper}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="LblAuthor" Text="Author"
                                                   Style="{StaticResource ClipsyBodyStrong}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="LblAuthorName" Text="Sidiusz"
                                                       Style="{StaticResource ClipsyHelper}" />
                                            <TextBlock Text="·" Style="{StaticResource ClipsyHelper}" />
                                            <TextBlock x:Name="LblMit" Text="CPIUL-1.2 license" Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource ClipsyHairline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="github.com/Sidiusz/Clipsy"
                                                       Style="{StaticResource ClipsyBodyStrong}" />
                                            <TextBlock x:Name="LblGithubLine" Text="Source, issues, releases"
                                                       Style="{StaticResource ClipsyHelper}" />
                                        </StackPanel>
                                        <HyperlinkButton x:Name="LinkGithubOpen" Grid.Column="1"
                                                         Content="Open"
                                                         NavigateUri="https://github.com/Sidiusz/Clipsy"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClipsyGroupCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblLikeClipsy" Text="Like Clipsy?" Style="{StaticResource ClipsyBodyStrong}" />
                                        <TextBlock x:Name="LblLikeClipsyHint" Text="Star it on GitHub - that's enough." Style="{StaticResource ClipsyHelper}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1"
                                                     NavigateUri="https://github.com/Sidiusz/Clipsy"
                                                     VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE735;" FontSize="13" />
                                            <TextBlock x:Name="LblStarBtn" Text="Star" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ============== Footer ============== -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{ThemeResource ClipsyBg0Brush}"
                    BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Reset is the destructive action — pushed to the far left and
                             styled danger so it's never confused with Save/Close. -->
                        <Button x:Name="BtnReset" Style="{StaticResource ClipsyButtonDanger}"
                                Content="Reset" Click="OnReset" MinWidth="120" />
                        <TextBlock x:Name="FooterStatusText"
                                   Style="{StaticResource ClipsyHelper}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- Equal width so Close/Save read as a paired action. -->
                        <Button x:Name="BtnClose" Content="Close" Click="OnClose" MinWidth="120" />
                        <Button x:Name="BtnSave" Style="{StaticResource ClipsyButtonPrimary}"
                                Content="Save changes" Click="OnSave" MinWidth="120" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============== Notification banner (bottom-right overlay) ============== -->
            <Border x:Name="NotifyBanner" Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource ClipsyBg2Brush}"
                    BorderBrush="{ThemeResource ClipsyBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,24,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border x:Name="NotifyAccentBar" Width="3" Height="22"
                            Background="{ThemeResource ClipsyAccentBrush}"
                            CornerRadius="2" />
                    <FontIcon x:Name="NotifyIcon" Glyph="&#xE73E;" FontSize="14"
                              Foreground="{ThemeResource ClipsyAccentBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="NotifyMessage"
                               Style="{StaticResource ClipsyBody}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource ClipsyTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
