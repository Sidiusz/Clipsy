<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Clipsy.Views.ColorPickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8" Width="312">
        <Border CornerRadius="4" Background="Black">
            <Grid x:Name="SpectrumSurface"
                  Width="312" Height="196"
                  Background="Transparent"
                  PointerPressed="OnSpectrumPointerPressed"
                  PointerMoved="OnSpectrumPointerMoved"
                  PointerReleased="OnSpectrumPointerReleased"
                  PointerCaptureLost="OnSpectrumPointerCaptureLost">
                <Image x:Name="SpectrumImage" Stretch="Fill" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SpectrumIndicator"
                             Width="13" Height="13"
                             Fill="Transparent"
                             Stroke="White" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Height="28">
            <Border Height="12" CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop x:Name="ValueGradientStop" Color="Red" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="ValueSlider"
                    Minimum="0" Maximum="100" Value="100"
                    StepFrequency="1"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="OnValueSliderChanged"
                    KeyUp="OnValueSliderKeyUp"
                    LostFocus="OnValueSliderLostFocus">
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                </Slider.Resources>
            </Slider>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="EyedropperBtn"
                    Grid.Column="0"
                    Style="{StaticResource ClipsyIconButton}"
                    Visibility="Collapsed"
                    Click="OnEyedropperClick">
                <FontIcon Glyph="&#xEF3C;" FontSize="14" />
            </Button>

            <TextBox x:Name="HexBox"
                     Grid.Column="1"
                     Width="96"
                     MaxLength="9"
                     HorizontalAlignment="Left"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     KeyDown="OnHexKeyDown"
                     LostFocus="OnHexLostFocus" />

            <Button x:Name="CancelBtn"
                    Grid.Column="2"
                    Style="{StaticResource ClipsyIconButton}"
                    Margin="0,0,6,0"
                    Click="OnCancelClick">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>

            <Button x:Name="ConfirmBtn"
                    Grid.Column="3"
                    Style="{StaticResource ClipsyIconButton}"
                    Background="{ThemeResource ClipsyAccentBrush}"
                    Click="OnConfirmClick">
                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="Black" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
