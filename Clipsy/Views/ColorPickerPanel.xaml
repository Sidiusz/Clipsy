<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy · ColorPickerPanel
  Shared UserControl: ColorPicker spectrum + Cancel / Confirm buttons + optional eyedropper.
  Used by CaptureOverlayWindow (canvas flyout, ShowEyedropper=True) and
  HudColorPickerWindow (recording floating picker, no eyedropper).
-->
<UserControl
    x:Class="Clipsy.Views.ColorPickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8" Width="312">
        <ColorPicker x:Name="ColorPickerCtl"
                     ColorSpectrumShape="Box"
                     IsAlphaEnabled="False"
                     IsColorSliderVisible="False"
                     IsColorChannelTextInputVisible="False"
                     IsHexInputVisible="True"
                     IsMoreButtonVisible="False"
                     ColorChanged="OnColorChanged" />
        <Grid Height="28">
            <Border Height="12" CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop x:Name="ValueGradientStop" Color="Red" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" Value="100"
                    StepFrequency="1" IsThumbToolTipEnabled="False"
                    ValueChanged="OnValueSliderChanged">
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                </Slider.Resources>
            </Slider>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Eyedropper: hidden by default; set ShowEyedropper=True for canvas -->
            <Button x:Name="EyedropperBtn" Grid.Column="0"
                    Style="{StaticResource ClipsyIconButton}"
                    Visibility="Collapsed"
                    Click="OnEyedropperClick">
                <FontIcon Glyph="&#xEF3C;" FontSize="14" />
            </Button>
            <Button x:Name="CancelBtn" Grid.Column="2"
                    Style="{StaticResource ClipsyIconButton}"
                    Margin="0,0,6,0"
                    Click="OnCancelClick">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
            <Button x:Name="ConfirmBtn" Grid.Column="3"
                    Style="{StaticResource ClipsyIconButton}"
                    Background="{ThemeResource ClipsyAccentBrush}"
                    Click="OnConfirmClick">
                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="Black" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
