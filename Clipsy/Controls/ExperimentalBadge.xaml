<UserControl
    x:Class="Clipsy.Controls.ExperimentalBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="22" Height="20"
    VerticalAlignment="Center">
    <ToolTipService.ToolTip>
        <ToolTip x:Name="WarningTip" MaxWidth="360">
            <TextBlock x:Name="WarningText" MaxWidth="340" TextWrapping="Wrap" />
        </ToolTip>
    </ToolTipService.ToolTip>
    <Grid Width="22" Height="20">
        <Path Data="M 11,1.4 C 11.9,1.4 12.7,1.9 13.2,2.8 L 20.2,15.1 C 21.1,16.7 20,18.5 18.2,18.5 L 3.8,18.5 C 2,18.5 0.9,16.7 1.8,15.1 L 8.8,2.8 C 9.3,1.9 10.1,1.4 11,1.4 Z"
              Fill="{ThemeResource ClipsyDangerDimBrush}"
              Stroke="{ThemeResource ClipsyDangerBrush}"
              StrokeThickness="1.2" />
        <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,3,0,0" Foreground="{ThemeResource ClipsyDangerBrush}"
                   FontSize="11" FontWeight="Bold" />
    </Grid>
</UserControl>
