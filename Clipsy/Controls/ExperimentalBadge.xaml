<UserControl
    x:Class="Clipsy.Controls.ExperimentalBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="20" Height="18"
    VerticalAlignment="Center">
    <ToolTipService.ToolTip>
        <ToolTip x:Name="WarningTip" MaxWidth="360">
            <TextBlock x:Name="WarningText" MaxWidth="340" TextWrapping="Wrap" />
        </ToolTip>
    </ToolTipService.ToolTip>
    <Border Background="{ThemeResource ClipsyDangerDimBrush}"
            BorderBrush="{ThemeResource ClipsyDangerBrush}"
            BorderThickness="1" CornerRadius="4">
        <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource ClipsyDangerBrush}"
                   FontSize="12" FontWeight="Bold" />
    </Border>
</UserControl>