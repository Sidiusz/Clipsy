<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy design tokens.
  Surface stack, semantic colors, brushes, type tokens, radii, font families.
  Mirrors components/tokens.jsx from the design mockup. Drop into Themes/ and
  merge from App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colors: surface stack ===== -->
    <Color x:Key="ClipsyBg0">#FF1A1B1E</Color>
    <Color x:Key="ClipsyBg1">#FF232428</Color>
    <Color x:Key="ClipsyBg2">#FF2B2D31</Color>
    <Color x:Key="ClipsyBg3">#FF35373C</Color>
    <Color x:Key="ClipsyBgInput">#FF1E1F22</Color>
    <Color x:Key="ClipsyBgHover">#FF393B40</Color>
    <Color x:Key="ClipsyBgActive">#FF404249</Color>

    <!-- Borders -->
    <Color x:Key="ClipsyBorderSubtle">#FF1F2023</Color>
    <Color x:Key="ClipsyBorder">#FF3F4147</Color>
    <Color x:Key="ClipsyBorderStrong">#FF4E5058</Color>

    <!-- Text -->
    <Color x:Key="ClipsyText">#FFF2F3F5</Color>
    <Color x:Key="ClipsyText2">#FFB5BAC1</Color>
    <Color x:Key="ClipsyText3">#FF80848E</Color>
    <Color x:Key="ClipsyText4">#FF5C5E66</Color>

    <!-- Accent (Discord blurple) -->
    <!-- Brand accent: amber/orange. Matches the highlight tone in the
         right-click context menu mockup. Hover/Pressed go progressively
         darker; Dim is the same hue at low alpha for subtle backgrounds. -->
    <Color x:Key="ClipsyAccent">#FFF59E0B</Color>
    <Color x:Key="ClipsyAccentHover">#FFD97706</Color>
    <Color x:Key="ClipsyAccentPressed">#FFB45309</Color>
    <Color x:Key="ClipsyAccentDim">#28F59E0B</Color>
    <Color x:Key="ClipsyAccentDimStrong">#3DF59E0B</Color>

    <!-- Semantic -->
    <Color x:Key="ClipsyDanger">#FFF23F42</Color>
    <Color x:Key="ClipsyDangerHover">#FFD43539</Color>
    <Color x:Key="ClipsyDangerDim">#28F23F42</Color>
    <Color x:Key="ClipsySuccess">#FF23A55A</Color>
    <Color x:Key="ClipsyWarning">#FFF0B232</Color>

    <!-- Selection on capture overlay (alpha for cut-outs) -->
    <Color x:Key="ClipsyOverlayDim">#800A0B0D</Color>
    <Color x:Key="ClipsyOverlayPanel">#F0232428</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="ClipsyBg0Brush"            Color="{StaticResource ClipsyBg0}" />
    <SolidColorBrush x:Key="ClipsyBg1Brush"            Color="{StaticResource ClipsyBg1}" />
    <SolidColorBrush x:Key="ClipsyBg2Brush"            Color="{StaticResource ClipsyBg2}" />
    <SolidColorBrush x:Key="ClipsyBg3Brush"            Color="{StaticResource ClipsyBg3}" />
    <SolidColorBrush x:Key="ClipsyBgInputBrush"        Color="{StaticResource ClipsyBgInput}" />
    <SolidColorBrush x:Key="ClipsyBgHoverBrush"        Color="{StaticResource ClipsyBgHover}" />
    <SolidColorBrush x:Key="ClipsyBgActiveBrush"       Color="{StaticResource ClipsyBgActive}" />

    <SolidColorBrush x:Key="ClipsyBorderSubtleBrush"   Color="{StaticResource ClipsyBorderSubtle}" />
    <SolidColorBrush x:Key="ClipsyBorderBrush"         Color="{StaticResource ClipsyBorder}" />
    <SolidColorBrush x:Key="ClipsyBorderStrongBrush"   Color="{StaticResource ClipsyBorderStrong}" />

    <SolidColorBrush x:Key="ClipsyTextBrush"           Color="{StaticResource ClipsyText}" />
    <SolidColorBrush x:Key="ClipsyText2Brush"          Color="{StaticResource ClipsyText2}" />
    <SolidColorBrush x:Key="ClipsyText3Brush"          Color="{StaticResource ClipsyText3}" />
    <SolidColorBrush x:Key="ClipsyText4Brush"          Color="{StaticResource ClipsyText4}" />

    <SolidColorBrush x:Key="ClipsyAccentBrush"         Color="{StaticResource ClipsyAccent}" />
    <SolidColorBrush x:Key="ClipsyAccentHoverBrush"    Color="{StaticResource ClipsyAccentHover}" />
    <SolidColorBrush x:Key="ClipsyAccentPressedBrush"  Color="{StaticResource ClipsyAccentPressed}" />
    <SolidColorBrush x:Key="ClipsyAccentDimBrush"      Color="{StaticResource ClipsyAccentDim}" />
    <SolidColorBrush x:Key="ClipsyAccentDimStrongBrush" Color="{StaticResource ClipsyAccentDimStrong}" />
    <SolidColorBrush x:Key="ClipsyCodecSelectedBrush"  Color="#FF323650" />

    <SolidColorBrush x:Key="ClipsyDangerBrush"         Color="{StaticResource ClipsyDanger}" />
    <SolidColorBrush x:Key="ClipsyDangerHoverBrush"    Color="{StaticResource ClipsyDangerHover}" />
    <SolidColorBrush x:Key="ClipsyDangerDimBrush"      Color="{StaticResource ClipsyDangerDim}" />
    <SolidColorBrush x:Key="ClipsySuccessBrush"        Color="{StaticResource ClipsySuccess}" />
    <SolidColorBrush x:Key="ClipsyWarningBrush"        Color="{StaticResource ClipsyWarning}" />
    <SolidColorBrush x:Key="ClipsyWarningDimBrush"     Color="#28F0B232" />

    <SolidColorBrush x:Key="ClipsyOverlayDimBrush"     Color="{StaticResource ClipsyOverlayDim}" />
    <SolidColorBrush x:Key="ClipsyOverlayPanelBrush"   Color="{StaticResource ClipsyOverlayPanel}" />

    <!-- ===== Type tokens ===== -->
    <!-- Bundled Onest variable font. ms-appx URI lets WinUI 3 resolve the
         .ttf shipped under Assets/Fonts/ without a system install. Fallbacks
         keep the UI legible if the font file is missing for any reason. -->
    <x:String x:Key="ClipsyFontFamily">ms-appx:///Assets/Fonts/Onest-VariableFont_wght.ttf#Onest, Inter, Segoe UI, sans-serif</x:String>
    <x:String x:Key="ClipsyFontFamilyMono">JetBrains Mono, Cascadia Mono, Consolas, monospace</x:String>

    <x:Double x:Key="ClipsyFontSizeBody">13</x:Double>
    <x:Double x:Key="ClipsyFontSizeHelper">11</x:Double>
    <x:Double x:Key="ClipsyFontSizeLabel">11</x:Double>
    <x:Double x:Key="ClipsyFontSizeTitle">20</x:Double>
    <x:Double x:Key="ClipsyFontSizeHero">26</x:Double>

    <!-- ===== Radius ===== -->
    <CornerRadius x:Key="ClipsyRadiusXs">3</CornerRadius>
    <CornerRadius x:Key="ClipsyRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="ClipsyRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="ClipsyRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="ClipsyRadiusXl">12</CornerRadius>

    <!-- ===== Sizes ===== -->
    <x:Double x:Key="ClipsyToolButtonSize">32</x:Double>
    <x:Double x:Key="ClipsyToolGlyphSize">16</x:Double>
    <x:Double x:Key="ClipsyControlHeight">30</x:Double>
    <x:Double x:Key="ClipsyControlHeightSm">26</x:Double>

    <!-- ===== WinUI default overrides — make every built-in control inherit Clipsy palette ===== -->
    <!-- Page background -->
    <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="ClipsyBg1Brush" />

    <!-- Text foreground -->
    <StaticResource x:Key="TextFillColorPrimaryBrush"   ResourceKey="ClipsyTextBrush" />
    <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="ClipsyText2Brush" />
    <StaticResource x:Key="TextFillColorTertiaryBrush"  ResourceKey="ClipsyText3Brush" />

    <!-- Accent (Discord blurple bleeds into ToggleSwitch, focus rings, etc.) -->
    <StaticResource x:Key="SystemAccentColor"          ResourceKey="ClipsyAccent" />
    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="ClipsyAccentBrush" />
    <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="ClipsyAccentHoverBrush" />
    <StaticResource x:Key="AccentFillColorTertiaryBrush"  ResourceKey="ClipsyAccentPressedBrush" />

    <!-- ComboBox / TextBox / NumberBox backgrounds -->
    <StaticResource x:Key="ComboBoxBackground"            ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPressed"     ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundDisabled"    ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundUnfocused"   ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxBackgroundFocused"     ResourceKey="ClipsyBgInputBrush" />

    <StaticResource x:Key="TextControlBackground"            ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused"     ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="TextControlBackgroundDisabled"    ResourceKey="ClipsyBgInputBrush" />

    <!-- ComboBox / TextBox border colors (subtle) -->
    <StaticResource x:Key="ComboBoxBorderBrush"            ResourceKey="ClipsyBorderSubtleBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ClipsyBorderBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed"     ResourceKey="ClipsyBorderBrush" />
    <StaticResource x:Key="TextControlBorderBrush"             ResourceKey="ClipsyBorderSubtleBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver"  ResourceKey="ClipsyBorderBrush" />
    <StaticResource x:Key="TextControlBorderBrushFocused"      ResourceKey="ClipsyAccentBrush" />

    <!-- Surfaces used in ComboBox popup -->
    <StaticResource x:Key="ComboBoxDropDownBackground"            ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxItemBackground"                ResourceKey="ClipsyBgInputBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver"     ResourceKey="ClipsyBg3Brush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed"         ResourceKey="ClipsyBgActiveBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected"        ResourceKey="ClipsyBg3Brush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="ClipsyBg3Brush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed"     ResourceKey="ClipsyBgActiveBrush" />

</ResourceDictionary>
