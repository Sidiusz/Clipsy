    <!-- Radio button as a full-width card row (used in Video codec picker) -->
    <Style x:Key="ClipsyRadioCard" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusMd}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="HoverOverlay"
                                Background="{StaticResource ClipsyBgHoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="16" Height="16"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse x:Name="OuterEllipse"
                                         Stroke="{StaticResource ClipsyBorderBrush}"
                                         StrokeThickness="1.5" Fill="Transparent" />
                                <Ellipse x:Name="InnerEllipse" Width="8" Height="8"
                                         Fill="{StaticResource ClipsyAccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyCodecSelectedBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource ClipsyAccentBrush}" />
                                        <Setter Target="OuterEllipse.Stroke" Value="{StaticResource ClipsyAccentBrush}" />
                                        <Setter Target="InnerEllipse.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="Transparent" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource ClipsyBorderSubtleBrush}" />
                                        <Setter Target="OuterEllipse.Stroke" Value="{StaticResource ClipsyBorderBrush}" />
                                        <Setter Target="InnerEllipse.Visibility" Value="Collapsed" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyText2Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

