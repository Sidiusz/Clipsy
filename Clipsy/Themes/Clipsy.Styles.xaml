<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipsy control styles. Targets the same classes used in your existing
  XAML — Button, ToggleButton, TextBox, ComboBox, ToggleSwitch, Slider —
  plus named styles for IconButtons, toolbars, cards, kbd, etc.

  Drop into Themes/ and merge from App.xaml (after Clipsy.Tokens.xaml).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- ============================================================
         Implicit font application
         ============================================================
         WinUI 3 does not inherit FontFamily down arbitrary visual trees,
         so apply the Clipsy font as the implicit default for every
         text-bearing control. Named TextBlock styles override this — so
         each named TextBlock style below also re-sets FontFamily to the
         same token (mono style keeps its monospace family).
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
    </Style>
    <Style TargetType="ContentPresenter">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
    </Style>

    <!-- ============================================================
         Buttons
         ============================================================
         ClipsyButton          : default button, neutral bg-3 surface
         ClipsyButtonPrimary   : accent CTA
         ClipsyButtonGhost     : transparent with subtle border
         ClipsyButtonDanger    : danger CTA (stop, delete)
    -->
    <Style x:Key="ClipsyButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ClipsyBg3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusSm}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Height" Value="{StaticResource ClipsyControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBgHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBgActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NOTE: implicit Button style removed — broke ComboBox internal DropDownGlyph button.
         Use Style="{StaticResource ClipsyButton}" explicitly. -->
    <!--<Style TargetType="Button" BasedOn="{StaticResource ClipsyButton}" />-->

    <Style x:Key="ClipsyButtonPrimary" TargetType="Button" BasedOn="{StaticResource ClipsyButton}">
        <Setter Property="Background" Value="{StaticResource ClipsyAccentBrush}" />
        <!-- Black text on amber for legibility; the inherited template
             swaps Background to hover/pressed stops but leaves foreground. -->
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClipsyButtonGhost" TargetType="Button" BasedOn="{StaticResource ClipsyButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBg2Brush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBg3Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClipsyButtonDanger" TargetType="Button" BasedOn="{StaticResource ClipsyButtonPrimary}">
        <Setter Property="Background" Value="{StaticResource ClipsyDangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyDangerHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClipsyButtonSm" TargetType="Button" BasedOn="{StaticResource ClipsyButton}">
        <Setter Property="Height" Value="{StaticResource ClipsyControlHeightSm}" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ============================================================
         Icon Button — 32x32 transparent tool button used in overlays
         ============================================================
         Default (no Tag)         : neutral
         Tag = "active"           : currently-selected tool (accent fill)
         Tag = "danger"           : record / stop hue on hover
    -->
    <Style x:Key="ClipsyIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource ClipsyToolButtonSize}" />
        <Setter Property="Height" Value="{StaticResource ClipsyToolButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusMd}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBg3Brush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBgActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClipsyIconButtonActive" TargetType="Button" BasedOn="{StaticResource ClipsyIconButton}">
        <Setter Property="Background" Value="{StaticResource ClipsyAccentDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyAccentBrush}" />
    </Style>

    <!-- Selected tool: amber tint + amber border that survives PointerOver.
         The base ClipsyIconButton template's PointerOver state forces
         Background to grey, which overwrites the inline amber. This style
         supplies its own template with amber stops for Normal / Hover /
         Pressed so the active state never reads as grey on hover. -->
    <Style x:Key="ClipsyIconButtonSelected" TargetType="Button" BasedOn="{StaticResource ClipsyIconButton}">
        <Setter Property="Background" Value="{StaticResource ClipsyAccentDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentDimStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="Black" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClipsyIconButtonDanger" TargetType="Button" BasedOn="{StaticResource ClipsyIconButton}">
        <Setter Property="Foreground" Value="{StaticResource ClipsyDangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyDangerDimBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyDangerDimBrush}" />
                                        <Setter Target="RootGrid.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton variant (used by Draw toggle in HUD) -->
    <Style x:Key="ClipsyIconToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource ClipsyToolButtonSize}" />
        <Setter Property="Height" Value="{StaticResource ClipsyToolButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBg3Brush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyBgActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentDimBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource ClipsyAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentDimStrongBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource ClipsyAccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClipsyAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource ClipsyAccentDimStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Text input
         ============================================================ -->
    <Style x:Key="ClipsyTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ClipsyBgInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusSm}" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="MinHeight" Value="{StaticResource ClipsyControlHeight}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource ClipsyAccentBrush}" />
    </Style>
    <!--<Style TargetType="TextBox" BasedOn="{StaticResource ClipsyTextBox}" />-->

    <!-- ============================================================
         Combo box
         ============================================================ -->
    <Style x:Key="ClipsyComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ClipsyBgInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusSm}" />
        <Setter Property="MinHeight" Value="{StaticResource ClipsyControlHeight}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4,8,4" />
    </Style>
    <!--<Style TargetType="ComboBox" BasedOn="{StaticResource ClipsyComboBox}" />-->

    <!-- ============================================================
         ToggleSwitch — strip the Header label area to look like our pill
         ============================================================ -->
    <Style x:Key="ClipsyToggleSwitch" TargetType="ToggleSwitch">
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================================================
         Window-level surfaces
         ============================================================ -->

    <!-- Toolbar pill (capture overlay + HUD share this) -->
    <Style x:Key="ClipsyToolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClipsyBg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusLg}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Vertical separator inside toolbar -->
    <Style x:Key="ClipsyToolbarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource ClipsyBorderBrush}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ClipsyToolbarSeparatorHorizontal" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource ClipsyBorderBrush}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Group card used inside Settings -->
    <Style x:Key="ClipsyGroupCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClipsyBg2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ClipsyBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ClipsyRadiusLg}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Hairline divider used between rows -->
    <Style x:Key="ClipsyHairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource ClipsyBorderSubtleBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============================================================
         Text styles
         ============================================================ -->

    <!-- 11 / 600 uppercase label -->
    <Style x:Key="ClipsyLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText3Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- 13 / 500 strong body -->
    <Style x:Key="ClipsyBodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 13 body -->
    <Style x:Key="ClipsyBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 11 helper (parameter descriptions) -->
    <Style x:Key="ClipsyHelper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText3Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 20 section title -->
    <Style x:Key="ClipsySectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ClipsyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyTextBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Monospace -->
    <Style x:Key="ClipsyMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
    </Style>

    <!-- Sidebar nav radio: accent bar + bg highlight + icon recolor on selection -->
    <Style x:Key="ClipsyNavRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ClipsyText2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="AccentBar" Grid.Column="0"
                                   Width="3" Height="22"
                                   Fill="{StaticResource ClipsyAccentBrush}"
                                   RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <Border x:Name="RootBorder" Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="8,0,8,0">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
