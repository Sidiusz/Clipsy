<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Clipsy</RootNamespace>
    <AssemblyName>Clipsy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3</InformationalVersion>
    <ApplicationIcon>Assets\Icons\clipsy.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Trim per-locale satellite assemblies (en + ru only). Drops 80+
         Microsoft.UI.Xaml.dll.mui folders from output. -->
    <SatelliteResourceLanguages>en;en-US;ru;ru-RU</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.7.x: fixes a family of Microsoft.UI.Input.dll 0xc0000409 fail-fast
         crashes that killed the tray/hotkeys silently on 1.6. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.4" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.1.240916" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\clipsy.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Drop x86 native Tesseract DLLs on x64 builds. The Tesseract NuGet
       targets file copies both x86\ and x64\ unconditionally. -->
  <Target Name="StripTesseractX86" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup Condition="'$(Platform)' == 'x64' or '$(PlatformTarget)' == 'x64'">
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.Link)').StartsWith('x86\'))" />
    </ItemGroup>
  </Target>

  <!-- Delete the win-x64/ duplicate subtree msbuild creates next to the
       non-RID output when -p:Platform=x64 is used without -r. Saves ~195 MB
       in bin\. Safe: nothing in the project references this path. -->
  <Target Name="StripRidDuplicate" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)\win-x64" Condition="Exists('$(OutDir)\win-x64') and '$(RuntimeIdentifier)' == ''" />
  </Target>

  <!-- Strip Microsoft.UI.Xaml.dll.mui native resource folders for every
       locale except en-* / ru-*. These ship from WindowsAppSDK as plain
       files, so SatelliteResourceLanguages doesn't filter them. -->
  <Target Name="StripMuiLocales" AfterTargets="Build">
    <ItemGroup>
      <_LocaleDirs Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
      <_LocaleDirsToKill Include="@(_LocaleDirs)"
        Condition="Exists('%(Identity)\Microsoft.ui.xaml.dll.mui') and
                   !$([System.String]::Copy('%(Filename)').StartsWith('en-', StringComparison.OrdinalIgnoreCase)) and
                   !$([System.String]::Copy('%(Filename)').StartsWith('ru-', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <RemoveDir Directories="@(_LocaleDirsToKill)" />
  </Target>
</Project>





